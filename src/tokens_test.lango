import js global Uint8Array
import js global Date
import js global Math
import js "node:crypto" as crypto
import js "node:buffer" as buffer
import js "jsonwebtoken" as jwt
import js "jose" as jose
import "./tokens"
    class TokenService

export main(args)

configuration(key)
    return {
        issuer: "lango-test"
        audience: "browser"
        activeKeyId: "current"
        keys: {
            current: key
        }
    }

invalid(service, raw)
    rejected = false
    try
        service.verify(raw)
    catch error
        assert error == "ApiInvalidToken"
        rejected = true
    assert rejected
    return null

raw(key, claims, algorithm = "HS256", typ = "lango+jwt", id = "current")
    return jwt/default/sign(claims, buffer/Buffer/from(key), {
        algorithm: algorithm
        header: {
            typ: typ
            kid: id
        }
    })

main(args)
    key = crypto/randomBytes(64)
    saved = new Uint8Array(key)
    service = new TokenService(configuration(key))
    key.fill(0)
    signed = service.sign({
        auth: true
        userId: "ada"
        iss: "untrusted"
        aud: "untrusted"
        exp: 1
    })
    claims = service.verify(signed)
    assert claims.auth
    assert claims.userId == "ada"
    assert claims.iss == "lango-test"
    assert claims.aud == "browser"
    assert claims.exp > claims.iat
    invalid(service, "not-a-token")
    invalid(service, "${signed}x")
    other = configuration(saved)
    other.audience = "wrong"
    invalid(new TokenService(other), signed)
    invalid(new TokenService(configuration(crypto/randomBytes(64))), signed)
    for ["HS384", "HS512"] as algorithm
        invalid(service, raw(saved, claims, algorithm))
    invalid(service, raw(saved, claims, "HS256", "JWT"))
    invalid(service, raw(saved, claims, "HS256", "lango+jwt", "unknown"))
    println("PASS synchronous token round-trip, reserved claims, key isolation, audience and header policy")
    previous = configuration(saved)
    previous.activeKeyId = "previous"
    previous.keys = {
        previous: saved
    }
    old = new TokenService(previous)
    rotated = configuration(crypto/randomBytes(32))
    rotated.keys.previous = saved
    retained = new TokenService(rotated)
    oldToken = old.sign({
        auth: false
    })
    assert !retained.verify(oldToken).auth
    invalid(service, oldToken)
    println("PASS retained rotation keys verify and removed key ids are rejected")
    expired = from_json(to_json(claims))
    expired.iat = 1
    expired.exp = 2
    expired.privateForm = "must-not-survive"
    expiredToken = raw(saved, expired)
    invalid(service, expiredToken)
    session = service.startSession(expiredToken)
    assert !session.registered
    assert session.claims.clientId == claims.clientId
    assert !session.claims.auth
    restarted = session.claims
    assert restarted.privateForm == null
    assert restarted.sessionId != claims.sessionId
    first = service.startSession(signed)
    second = service.startSession(signed)
    assert first.claims.clientId == second.claims.clientId
    assert first.claims.sessionId != second.claims.sessionId
    assert !first.claims.auth
    assert service.verify(signed).auth
    anonymous = service.startSession(null)
    another = service.startSession(null)
    assert anonymous.registered
    assert anonymous.claims.clientId != another.claims.clientId
    assert anonymous.claims.sessionId != another.claims.sessionId
    println("PASS expired signatures recover only client identity; sessions, auth and form claims start fresh")
    return interoperability(service, signed, saved)

interoperability(service, signed, key)
    return jose/jwtVerify(signed, key, {
        algorithms: ["HS256"]
        issuer: "lango-test"
        audience: "browser"
    }).then((verified)
        capture key
        assert verified.payload.userId == "ada"
        signer = new jose/SignJWT(verified.payload)
        signer.setProtectedHeader({
            alg: "HS256"
            typ: "lango+jwt"
            kid: "current"
        })
        return signer.sign(key)
    ).then((raw)
        capture service
        assert service.verify(raw).userId == "ada"
        println("PASS synchronous JWTs verify jose signatures and jose verifies their signatures")
    )
