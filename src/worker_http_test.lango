import js global Date
import js "node:fs" as fs
import js "node:path" as path
import js "node:os" as os
import js "node:crypto" as crypto
import js "node:sqlite" as sqlite
import "./http_test_support"
    class HttpTestServer
    waitForTestFile(file, deadline)
    waitForTestResponse(requests, deadline)

export main(args)

class Harness
    methods
        start()
        post(endpoint, input = null, bearer = null)
        bootstrap()
        ui()
        errors()
        parallel()
        queue()
        health()
        stop()

Harness()
    @directory = fs.mkdtempSync(path.join(os.tmpdir(), "lango-workers-"))
    @host = new HttpTestServer(@directory)
    @token = null
    @marker = path.join(@directory, "running")
    @database = path.join(@directory, "application.sqlite")

Harness:start()
    key = crypto/randomBytes(32)
    @host.start({
        appRoot: path.resolve(".")
        application: path.resolve(".test-output/worker_fixture.mjs")
        workerFile: path.resolve(".test-output/worker_entry.mjs")
        stateFile: path.join(@directory, "runtime.sqlite")
        namespace: "worker-test"
        host: "127.0.0.1"
        port: 0
        threads: 2
        maxQueue: 1
        bodyLimit: 4096
        tokens: {
            issuer: "worker-test"
            audience: "worker-test"
            activeKeyId: "current"
            keys: {
                current: key.toString("base64")
            }
        }
        options: {
            database: @database
            marker: @marker
        }
    })

Harness:post(endpoint, input = null, bearer = null)
    if bearer == null
        bearer = @token
    return @host.request(endpoint, input, bearer)

Harness:bootstrap()
    result = post("/_lango/start")
    assert result.status == 200
    assert is_string(result.token)
    @token = result.token

uiInput()
    return {
        formId: "profile"
        formInstanceId: "instance"
        seqno: 1
        values: {
            email: "hello@example.com"
            saveButton: null
        }
    }

Harness:ui()
    result = post("/app/save", uiInput())
    assert result.status == 200
    assert result.body.vals.email == "Saved: hello@example.com"
    assert result.body.cmds[0].type == "setProperty"
    assert result.body.cmds[0].name == "enabled"
    assert result.body.cmds[0].value == false
    assert result.thread != null
    duplicate = post("/app/save", uiInput())
    assert duplicate.status == 409
    assert duplicate.body.reason == "AlreadyConsumed"
    db = new sqlite/DatabaseSync(@database)
    try
        query = db.prepare("SELECT COUNT(*) AS total FROM visits")
        row = query.get()
        assert row.total == 1
    finally
        db.close()
    println("PASS Piscina dispatches a synchronous UI handler with form/context and SQLite replay protection")

Harness:errors()
    result = post("/bad")
    assert result.status == 500
    assert result.body.error == "InternalServerError"
    result = post("/throw")
    assert result.status == 500
    encoded = to_json(result.body)
    assert !encoded.includes("SensitiveWorkerDetail")
    assert post("/private").status == 401
    assert post("/info", null, "invalid").status == 401
    assert post("/missing").status == 404
    malformed = @host.raw("/info", "{")
    assert malformed.read().status == 400
    padding = "x"
    oversized = @host.raw("/info", padding.repeat(5000))
    assert oversized.read().status == 413
    println("PASS worker boundaries reject Promise handlers, malformed/oversized requests and invalid tokens without exposing errors")

Harness:parallel()
    resetReleaseFiles(@marker)
    slow = @host.pending("/slow", {
        milliseconds: 1000
        controlled: true
    }, @token)
    waitForTestFile(@marker, Date/now() + 10000)
    busyThread = fs.readFileSync(@marker, "utf8")
    health()
    other = post("/info")
    assert other.status == 200
    assert "${other.body.threadId}" != busyThread
    assert other.body.auth == false
    assert other.body.path == "/info"
    logout = post("/_lango/logout")
    assert logout.status == 200
    assert logout.body.loggedOut
    assert logout.token == null
    fs.writeFileSync("${@marker}.release", "release")
    assert slow.read().status == 401
    assert post("/info").status == 401
    println("PASS a blocked worker leaves HTTP and a second worker responsive; shared logout prevents late token renewal")

Harness:queue()
    resetReleaseFiles(@marker)
    first = @host.pending("/slow", {
        milliseconds: 1000
        controlled: true
    }, @token)
    second = @host.pending("/slow", {
        milliseconds: 1000
        controlled: true
        second: true
    }, @token)
    waitForTestFile(@marker, Date/now() + 10000)
    waitForTestFile("${@marker}.second", Date/now() + 10000)
    assert fs.readFileSync(@marker, "utf8") != fs.readFileSync("${@marker}.second", "utf8")
    health()
    waiting = [@host.pending("/info", null, @token), @host.pending("/info", null, @token)]
    rejected = waitForTestResponse(waiting, Date/now() + 10000)
    assert waiting[rejected].read().status == 503
    fs.writeFileSync("${@marker}.release", "release")
    fs.writeFileSync("${@marker}.second.release", "release")
    accepted = 1 - rejected
    assert waiting[accepted].read().status == 200
    assert first.read().status == 200
    assert second.read().status == 200
    println("PASS two workers run concurrently; a bounded queue rejects overload while HTTP health remains responsive")

Harness:health()
    pending = @host.raw("/health", null, null, "GET")
    assert pending.read().status == 200
    assert fs.existsSync(@marker)

resetReleaseFiles(marker)
    for ["${marker}.release", "${marker}.second.release"] as file
        fs.rmSync(file, {
            force: true
        })

Harness:stop()
    try
        fs.writeFileSync("${@marker}.release", "release")
        fs.writeFileSync("${@marker}.second.release", "release")
        @host.stop()
        println("PASS closing the returned HTTP server also closes its worker pool")
    finally
        fs.rmSync(@directory, {
            recursive: true
            force: true
        })

main(args)
    harness = new Harness()
    try
        harness.start()
        harness.bootstrap()
        harness.ui()
        harness.errors()
        harness.queue()
        harness.parallel()
    finally
        harness.stop()
