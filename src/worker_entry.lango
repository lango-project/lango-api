import js "node:worker_threads" as threads
import js global process
import "./worker_modules"
    initializeWorker(data)

export global execute

global runtime = null
global execute = initialize()

initialize()
    return initializeWorker(threads.workerData).then((ready)
        global runtime
        runtime = ready
        process.once("exit", ()
            global runtime
            runtime.close()
        )
        return workerHandler()
    )

workerHandler()
    return runTask

runTask(task)
    global runtime
    return runtime.handle(task)
