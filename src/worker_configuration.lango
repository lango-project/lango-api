import js "node:fs" as fs
import js "node:path" as path
import js "node:os" as os
import "./configuration"
    validateWorkers(configuration)
import "./jwt_configuration"
    loadTokenOptions(settings, revocations = null)

import "./lifecycle"
    createLifecycle(spec)
import "./authorization"
    createAuth(spec)
import "./api_registry"
    apiFromXml(xml)
import "./package_modules"
    prepareWorkerPackages(appRoot)
    resolveModule(appRoot, moduleName)

export workerConfiguration(configuration, routes = null)

workerConfiguration(configuration, routes = null)
    validateWorkers(configuration)
    if !is_string(configuration.appRoot) or configuration.appRoot == ""
        throw "ApiAppRootMustBeConfigured"
    if configuration.tokenService != null or configuration.stateStore != null
        throw "ApiWorkerInstancesMustBeCreatedInFactory"
    settings = configuration.workers
    appRoot = path.resolve(configuration.appRoot)
    lifecycle = parentLifecycle(configuration.lifecycle)
    definitions = parentRoutes(routes)
    apiXml = null
    apiFile = configuration.apiFile
    if apiFile == null and settings.application == null and routes == null
        candidate = path.join(appRoot, "deploy", "api.xml")
        if fs.existsSync(candidate)
            apiFile = candidate
    if apiFile != null
        apiFile = path.resolve(apiFile)
        if !fs.existsSync(apiFile)
            throw "ApiConfigFileNotFound: ${apiFile}"
        apiXml = fs.readFileSync(apiFile, "utf8")
        apiFromXml(apiXml)
    state = configuration.state
    if state == null
        state = {
        }
    if state.backend != null and state.backend != "sqlite"
        throw "ApiWorkersRequireSqliteState"
    file = state.file
    if file == null
        file = "runtime.sqlite"
    if !is_string(file) or file == "" or file == ":memory:"
        throw "ApiStateFileRequired"
    if !path.isAbsolute(file)
        if !is_string(configuration.stateDir) or configuration.stateDir == ""
            throw "ApiStateDirectoryRequired"
        file = path.resolve(configuration.stateDir, file)
    namespace = state.namespace
    if namespace == null
        namespace = configuration.applicationName
    tokens = null
    if configuration.jwt != null
        if configuration.jwt.enabled != false
            tokens = loadTokenOptions(configuration.jwt)
    workerFile = null
    if settings.workerFile != null
        workerFile = path.resolve(appRoot, settings.workerFile)
    options = factoryOptions(configuration, appRoot, settings)
    if configuration.mode != "server"
        prepareWorkerPackages(appRoot)
    application = settings.application
    if application == null and apiXml == null and routes == null
        application = "dist/worker.mjs"
    if application != null
        application = applicationFile(appRoot, application)
    return {
        appRoot: appRoot
        application: application
        apiXml: apiXml
        lifecycle: lifecycle
        routeDefinitions: definitions
        workerFile: workerFile
        stateFile: file
        namespace: namespace
        maxForms: state.maxForms
        host: configuration.host
        port: configuration.port
        threads: settings.threads
        maxQueue: settings.maxQueue
        bodyLimit: settings.bodyLimit
        bodyTimeoutMs: settings.bodyTimeoutMs
        rateLimit: settings.rateLimit
        rateWindowMs: settings.rateWindowMs
        rateMaxClients: settings.rateMaxClients
        requestTimeoutMs: settings.requestTimeoutMs
        startupTimeoutMs: settings.startupTimeoutMs
        shutdownTimeoutMs: settings.shutdownTimeoutMs
        tokens: tokens
        options: options
    }

factoryOptions(configuration, appRoot, settings)
    options = {
        applicationName: configuration.applicationName
        appRoot: appRoot
        dataDir: configuration.dataDir
        stateDir: configuration.stateDir
        logDir: configuration.logDir
    }
    extra = settings.options
    if settings.optionsFile != null
        file = path.resolve(appRoot, settings.optionsFile)
        if !fs.existsSync(file)
            throw "ApiWorkerOptionsFileNotFound: ${file}"
        try
            extra = from_json(fs.readFileSync(file, "utf8"))
        catch error
            throw "ApiWorkerOptionsFileMustBeJsonMap: ${file}"
        if !is_object(extra)
            throw "ApiWorkerOptionsFileMustBeJsonMap: ${file}"
    if extra != null
        for extra as name: value
            if name == "__proto__" or name == "constructor" or name == "prototype"
                throw "ApiWorkerReservedOptionName"
            options[name] = value
    return options

test "worker configuration resolves application options keys and SQLite against final paths"
    directory = fs.mkdtempSync(path.join(os.tmpdir(), "lango-worker-settings-"))
    appRoot = path.join(directory, "application")
    confRoot = path.join(directory, "configuration")
    fs.mkdirSync(path.join(appRoot, "dist"), {
        recursive: true
    })
    fs.mkdirSync(confRoot)
    fs.writeFileSync(path.join(appRoot, "dist", "worker.mjs"), "")
    fs.writeFileSync(path.join(appRoot, "options.json"), to_json({
        label: "from-file"
    }))
    fs.writeFileSync(path.join(confRoot, "keys.json"), to_json({
        current: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
    }))
    configuration = {
        applicationName: "shop"
        appRoot: appRoot
        stateDir: path.join(directory, "state")
        dataDir: path.join(directory, "data")
        logDir: path.join(directory, "logs")
        host: "127.0.0.1"
        port: 3000
        workers: {
            optionsFile: "options.json"
        }
        jwt: {
            issuer: "shop"
            audience: "browser"
            activeKeyId: "current"
            keysFile: "keys.json"
            keysBaseDir: confRoot
        }
    }
    try
        settings = workerConfiguration(configuration)
        assert settings.application == path.join(appRoot, "dist", "worker.mjs")
        assert settings.stateFile == path.join(directory, "state", "runtime.sqlite")
        assert settings.namespace == "shop"
        assert settings.threads == 2
        assert settings.options.label == "from-file"
        assert settings.options.appRoot == appRoot
        assert settings.options.stateDir == configuration.stateDir
        assert settings.tokens.keys.current.length == 32
        assert !fs.existsSync(configuration.stateDir)
        configuration.state = {
            backend: "memory"
        }
        try
            workerConfiguration(configuration)
            assert false
        catch error
            assert error == "ApiWorkersRequireSqliteState"
        configuration.state = null
        configuration.jwt.enabled = false
        configuration.jwt.keysFile = "missing.json"
        anonymous = workerConfiguration(configuration)
        assert anonymous.tokens == null
        configuration.workers.enabled = false
        configuration.workers.application = "missing.mjs"
        configuration.workers.optionsFile = "missing.json"
        rejected = false
        try
            workerConfiguration(configuration)
        catch error
            assert error == "ApiWorkersRequired"
            rejected = true
        assert rejected
    finally
        fs.rmSync(directory, {
            recursive: true
            force: true
        })

test "worker configuration rejects parent process instances and lifecycle callbacks"
    configuration = {
        appRoot: "/missing"
        workers: {
            enabled: true
        }
        tokenService: {
        }
    }
    try
        workerConfiguration(configuration)
        assert false
    catch error
        assert error == "ApiWorkerInstancesMustBeCreatedInFactory"
    configuration.tokenService = null
    configuration.lifecycle = {
        register: workerHook
    }
    try
        workerConfiguration(configuration)
        assert false
    catch error
        assert error == "ApiWorkerLifecycleMustBeCreatedInFactory"

workerHook(input)
    return null

applicationFile(appRoot, specifier)
    file = path.resolve(appRoot, specifier)
    if fs.existsSync(file)
        return file
    if !path.isAbsolute(specifier) and !specifier.startsWith(".") and !specifier.startsWith("dist/")
        return resolveModule(appRoot, specifier)
    throw "ApiWorkerApplicationNotFound: ${file}"

parentLifecycle(spec)
    handlers = createLifecycle(spec)
    for handlers as event: handler
        if handler != null
            if !is_string(handler.module) or !is_string(handler.function)
                throw "ApiWorkerLifecycleMustBeCreatedInFactory"
    return handlers

parentRoutes(routes)
    if routes == null
        return []
    result = []
    for routes as route
        if route.handler != null or route.module != null or !is_string(route.mod) or !is_string(route.func)
            throw "ApiWorkerRoutesMustBeCreatedInFactory"
        auth = createAuth(route.auth)
        if auth != null
            if !is_string(auth.module) or !is_string(auth.function)
                throw "ApiWorkerLifecycleMustBeCreatedInFactory"
        result.add({
            path: route.path
            mod: route.mod
            func: route.func
            anonymous: route.anonymous
            auth: auth
        })
    return result
