import js global Promise
import js "node:crypto" as crypto
import js "node:http" as http
import js "node:util" as util

import "./api_registry"
    findRoute(routes, requestPath)
    routeMissing(route)
import "./package_modules"
    resolveModule(appRoot, moduleName)
import "./authorization"
    createAuth(spec)
import "./lifecycle"
    createLifecycle(spec)
    initializeSession(session, handlers, appRoot)
import "./request_audit"
    observeRequest(configuration, httpResponse)
import "./ping"
    processPing(configuration, input)
    isPingRequest(configuration, path)


export start(configuration, routes)

class ApiResponse
    methods
        status(code)
        header(name, value)
        send(value)
        completed()
        bindToken(claims)
        discardTokenChanges()
        write(body, token)
        signingFailed()
        receiveInput(input)
        completedSnapshot()
        logout()

class RequestLog
    methods
        debug(message)
        info(message)
        warn(message)
        err(message)

ApiResponse(httpResponse, tokenService = null, requestId = null, auditEnabled = false)
    @httpResponse = httpResponse
    @statusCode = 200
    @completed = false
    @tokenService = tokenService
    @claims = null
    @requestId = requestId
    @auditEnabled = auditEnabled
    @input = null
    @logout = null

ApiResponse:receiveInput(input)
    if @auditEnabled
        @input = from_json(to_json(input))
    return null

ApiResponse:completedSnapshot()
    claims = @claims
    if claims == null
        claims = anonymousToken()
    return {
        status: @statusCode
        input: @input
        output: from_json(@body)
        token: from_json(to_json(claims))
    }

ApiResponse:bindToken(claims)
    @claims = claims
    @clientId = claims.clientId
    @sessionId = claims.sessionId
    @originalClaims = from_json(to_json(claims))
    return null

ApiResponse:discardTokenChanges()
    if @claims != null
        @claims = @originalClaims
    return null

ApiResponse:status(code)
    if !is_number(code) or code < 100 or code > 599 or code % 1 != 0
        throw "ApiResponseStatusMustBeAnIntegerBetween100And599"
    if @completed
        throw "ApiResponseAlreadySent"
    @statusCode = code
    return this

ApiResponse:header(name, value)
    if !is_string(name) or name == ""
        throw "ApiResponseHeaderNameMustBeAString"
    if @completed
        throw "ApiResponseAlreadySent"
    res = @httpResponse
    res.setHeader(name, value)
    return this

ApiResponse:send(value)
    if @completed
        throw "ApiResponseAlreadySent"
    body = to_json(value)
    @completed = true
    reply = this
    if @claims != null
        @claims.clientId = @clientId
        @claims.sessionId = @sessionId
    if @logout != null
        @claims.auth = false
        return @logout.then(()
            capture reply
            capture body
            reply.write(body, null)
        ).catch((error)
            capture reply
            reply.signingFailed()
        )
    if @tokenService != null and @claims != null
        try
            return @tokenService.sign(@claims).then((token)
                capture reply
                capture body
                reply.write(body, token)
            ).catch((error)
                capture reply
                reply.signingFailed()
            )
        catch error
            return this.signingFailed()
    return this.write(body, null)

ApiResponse:logout()
    if @completed
        throw "ApiResponseAlreadySent"
    if @tokenService == null or @claims == null
        throw "ApiTokenSessionRequired"
    if @logout == null
        @claims.auth = false
        @originalClaims.auth = false
        this.header("Cache-Control", "no-store")
        pending = @tokenService.revoke({
            sessionId: @sessionId
        })
        @logout = pending
        pending.catch((error)
            return null
        )
    return @logout

ApiResponse:write(body, token)
    if @auditEnabled
        @body = body
    res = @httpResponse
    if res.getHeader("Content-Type") == null
        res.setHeader("Content-Type", "application/json; charset=utf-8")
    res.statusCode = @statusCode
    if token != null
        res.setHeader("X-Lango-Token", token)
        res.setHeader("Cache-Control", "no-store")
    res.end(body)
    return null

ApiResponse:signingFailed()
    context log
    log.err("Token signing failed")
    @statusCode = 500
    @httpResponse.setHeader("Content-Type", "application/json; charset=utf-8")
    body = to_json({
        error: "InternalServerError"
        requestId: @requestId
    })
    return this.write(body, null)

ApiResponse:completed()
    return @completed

RequestLog(base, requestId)
    @base = base
    @requestId = requestId

RequestLog:debug(message)
    base = @base
    requestId = @requestId
    base.debug("[${requestId}] ${message}")
    return null

RequestLog:info(message)
    base = @base
    requestId = @requestId
    base.info("[${requestId}] ${message}")
    return null

RequestLog:warn(message)
    base = @base
    requestId = @requestId
    base.warn("[${requestId}] ${message}")
    return null

RequestLog:err(message)
    base = @base
    requestId = @requestId
    base.err("[${requestId}] ${message}")
    return null

requestContext(httpRequest, requestId)
    return {
        id: requestId
        method: httpRequest.method
        path: httpRequest.url
        headers: httpRequest.headers
        remoteAddress: httpRequest.socket.remoteAddress
    }

anonymousToken()
    return {
        auth: false
    }

bootstrapRoute()
    return {
        bootstrap: true
    }

pingRoute()
    return {
        ping: true
    }

logoutRoute()
    return {
        logout: true
        anonymous: true
    }

sendFailure(response, log, request)
    log.err("${request.method} ${request.path}: handler failed")
    if not response.completed()
        response.discardTokenChanges()
        response.status(500).send({
            error: "InternalServerError"
            requestId: request.id
        })
    return null

sendResult(response, log, request, result)
    if response.completed()
        return null
    if util/types/isPromise(result)
        result.then((value)
            capture response
            if not response.completed()
                response.send(value)
        ).catch((error)
            capture response
            capture log
            capture request
            sendFailure(response, log, request)
        )
        return null
    response.send(result)
    return null

start(configuration, routes)
    context log
    configuration.lifecycle = createLifecycle(configuration.lifecycle)
    for routes as configured
        configured.auth = createAuth(configured.auth)
    if configuration.tokenService != null
        for routes as configured
            if configured.path == "/_lango/start"
                throw "ApiTokenBootstrapPathIsReserved"
            if configured.path == "/_lango/ping"
                throw "ApiTokenPingPathIsReserved"
            if configured.path == "/_lango/logout"
                throw "ApiTokenLogoutPathIsReserved"
    server = new http/Server((httpRequest, httpResponse)
        capture configuration
        capture routes
        capture log
        capture crypto
        requestId = crypto/randomUUID()
        requestLog = new RequestLog(log, requestId)
        apiRequest = requestContext(httpRequest, requestId)
        auditEnabled = configuration.lifecycle.request != null and !isPingRequest(configuration, apiRequest.path)
        apiResponse = new ApiResponse(httpResponse, configuration.tokenService, requestId, auditEnabled)
        apiToken = anonymousToken()
        context log = requestLog
        context request = apiRequest
        context response = apiResponse
        context token = apiToken
        observeRequest(configuration, httpResponse)
        if httpRequest.method != "POST"
            requestLog.warn("${apiRequest.method} ${apiRequest.path}: method is not allowed")
            apiResponse.status(405).send({
                error: "MethodNotAllowed"
                requestId: apiRequest.id
            })
            return
        if apiRequest.path.indexOf("?") >= 0
            requestLog.warn("${apiRequest.method} ${apiRequest.path}: query parameters are not supported")
            apiResponse.status(400).send({
                error: "QueryNotSupported"
                requestId: apiRequest.id
            })
            return
        route = findRoute(routes, apiRequest.path)
        if apiRequest.path == "/_lango/start" and !routeMissing(configuration.tokenService)
            route = bootstrapRoute()
        if isPingRequest(configuration, apiRequest.path)
            route = pingRoute()
        if apiRequest.path == "/_lango/logout" and !routeMissing(configuration.tokenService)
            route = logoutRoute()
        if routeMissing(route)
            requestLog.warn("${apiRequest.method} ${apiRequest.path}: route was not found")
            apiResponse.status(404).send({
                error: "RouteNotFound"
                requestId: apiRequest.id
            })
            return
        if route.ping == true or route.logout == true
            apiResponse.header("Cache-Control", "no-store")
        body = ""
        authorization = httpRequest.headers.authorization
        httpRequest.on("data", (chunk)
            capture body
            body = "${body}${chunk}"
        )
        httpRequest.on("end", ()
            capture configuration
            capture route
            capture request
            capture response
            capture token
            capture log
            capture body
            capture authorization
            input = {
            }
            try
                if body != ""
                    input = from_json(body)
            catch error
                log.warn("${request.method} ${request.path}: invalid JSON request body")
                response.status(400).send({
                    error: "BadRequest"
                    requestId: request.id
                })
                return
            response.receiveInput(input)
            processRequest(configuration, route, input, authorization)
        )
    )
    server.on("error", (error)
        capture log
        log.err("HTTP server error")
    )
    server.listen(configuration.port, configuration.host)
    return server

bearerToken(authorization)
    if authorization == null
        return null
    if !is_string(authorization)
        throw "ApiInvalidToken"
    scheme = authorization.slice(0, 7)
    if scheme.toLowerCase() != "bearer "
        throw "ApiInvalidToken"
    value = authorization.slice(7)
    if value == ""
        throw "ApiInvalidToken"
    return value

unauthorized()
    context response
    context request
    response.header("WWW-Authenticate", "Bearer")
    response.status(401).send({
        error: "Unauthorized"
        requestId: request.id
    })
    return null

processRequest(configuration, route, input, authorization)
    context request
    context response
    context log
    if route.ping == true
        return processPing(configuration, input)
    return Promise/resolve().then(()
        capture configuration
        capture route
        capture authorization
        capture request
        capture response
        capture log
        return authenticate(configuration, authorization, route)
    ).then((claims)
        capture configuration
        capture route
        capture input
        capture request
        capture response
        capture log
        return dispatchRequest(claims, route, input, configuration)
    ).catch((error)
        capture request
        capture response
        capture log
        sendFailure(response, log, request)
    )

authenticate(configuration, authorization, route)
    context request
    context response
    context log
    service = configuration.tokenService
    if service == null
        return anonymousToken()
    raw = null
    try
        raw = bearerToken(authorization)
    catch error
        return unauthorized()
    if route.bootstrap == true
        return beginSession(service, raw, configuration)
    if raw == null
        if route.logout == true
            return unauthorized()
        if route.anonymous != true
            return unauthorized()
        return beginSession(service, raw, configuration)
    return service.verify(raw).catch((error)
        capture response
        capture request
        capture log
        return unauthorized()
    )

beginSession(service, raw, configuration)
    context request
    context response
    context log
    return service.startSession(raw).then((session)
        capture configuration
        capture request
        capture response
        capture log
        return initializeSession(session, configuration.lifecycle, configuration.appRoot)
    )

dispatchRequest(claims, route, input, configuration)
    context request
    context response
    context log
    if claims == null or response.completed()
        return null
    context token = claims
    response.bindToken(claims)
    if route.logout == true
        response.logout()
        return response.send({
            loggedOut: true
        })
    if route.bootstrap == true
        return response.send({
            clientId: claims.clientId
            sessionId: claims.sessionId
        })
    if configuration.tokenService != null and route.anonymous != true and claims.auth != true
        return unauthorized()
    appRoot = configuration.appRoot
    return authorizeRoute(route, input, appRoot).then((allowed)
        capture route
        capture input
        capture appRoot
        capture request
        capture response
        capture token
        capture log
        if allowed and !response.completed()
            return invokeRoute(route, input, appRoot)
    )

authorizeRoute(route, input, appRoot)
    context request
    context response
    context token
    context log
    if route.auth == null
        return Promise/resolve(true)
    return Promise/resolve().then(()
        capture route
        capture input
        capture appRoot
        capture request
        capture response
        capture token
        capture log
        return callAuth(route.auth, input, appRoot)
    ).then((allowed)
        capture request
        capture response
        return authorizationResult(allowed)
    ).catch((error)
        capture request
        capture response
        capture log
        return authorizationFailed()
    )

authorizationFailed()
    context request
    context response
    context log
    log.err("${request.method} ${request.path}: authorization failed")
    if not response.completed()
        response.discardTokenChanges()
        response.status(500).send({
            error: "InternalServerError"
            requestId: request.id
        })
    return false

callAuth(auth, input, appRoot)
    context request
    context response
    context token
    context log
    if is_kindof(auth.function, Function)
        return auth.function(request.path, input)
    if is_string(auth.module)
        moduleFile = resolveModule(appRoot, auth.module)
        return import_module(moduleFile).then((module)
            capture auth
            capture input
            capture request
            capture response
            capture token
            capture log
            return invokeAuthModule(module, auth.function, input)
        )
    return invokeAuthModule(auth.module, auth.function, input)

invokeAuthModule(module, name, input)
    context request
    return module[name](request.path, input)

authorizationResult(allowed)
    context request
    context response
    if not is_bool(allowed)
        throw "ApiAuthMustReturnBoolean"
    if response.completed()
        return false
    if not allowed
        response.discardTokenChanges()
        response.status(403).send({
            error: "Forbidden"
            requestId: request.id
        })
        return false
    return true

invokeRoute(route, input, appRoot)
    context request
    context response
    context token
    context log
    try
        if not routeMissing(route.handler)
            handlerResult = route.handler(input)
            return sendResult(response, log, request, handlerResult)
        module = route.module
        if not routeMissing(module)
            moduleResult = module[route.func](input)
            return sendResult(response, log, request, moduleResult)
        moduleFile = resolveModule(appRoot, route.mod)
        return import_module(moduleFile).then((module)
            capture input
            capture route
            capture request
            capture response
            capture token
            capture log
            importedResult = module[route.func](input)
            return sendResult(response, log, request, importedResult)
        ).catch((error)
            capture request
            capture response
            capture log
            sendFailure(response, log, request)
        )
    catch error
        sendFailure(response, log, request)
    return null

test "request context preserves HTTP metadata"
    httpRequest = {
        method: "POST"
        url: "/health"
        headers: {
            accept: "application/json"
        }
        socket: {
            remoteAddress: "127.0.0.1"
        }
    }
    request = requestContext(httpRequest, "request-1")
    assert request.id == "request-1"
    assert request.path == "/health"
    assert request.headers.accept == "application/json"
