import js "node:http" as http

import "./api_registry"
    findRoute(routes, requestPath)
    routeMissing(route)
import "./package_modules"
    resolveModule(appRoot, moduleName)

export start(configuration, routes)

sendResult(response, result)
    response.writeHead(200, {
        "Content-Type": "application/json; charset=utf-8"
    })
    response.end(to_json(result))

start(configuration, routes)
    context log
    server = new http/Server((request, response)
        capture configuration, routes, log
        if request.method != "POST"
            log.warn("${request.method} ${request.url}: method is not allowed")
            response.writeHead(405, {
                "Content-Type": "application/json; charset=utf-8"
            })
            response.end("{\"error\":\"MethodNotAllowed\"}")
            return
        if request.url.indexOf("?") >= 0
            log.warn("${request.method} ${request.url}: query parameters are not supported")
            response.writeHead(400, {
                "Content-Type": "application/json; charset=utf-8"
            })
            response.end("{\"error\":\"QueryNotSupported\"}")
            return
        route = findRoute(routes, request.url)
        if routeMissing(route)
            log.warn("${request.method} ${request.url}: route was not found")
            response.writeHead(404, {
                "Content-Type": "application/json; charset=utf-8"
            })
            response.end("{\"error\":\"RouteNotFound\"}")
            return
        body = ""
        appRoot = configuration.appRoot
        request.on("data", (chunk)
            capture body
            body = body + chunk.toString()
        )
        request.on("end", ()
            capture appRoot, route, response, body, log, request
            input = {}
            try
                if body != ""
                    input = from_json(body)
            catch error
                log.warn("${request.method} ${request.url}: invalid JSON request body")
                response.writeHead(400, {
                    "Content-Type": "application/json; charset=utf-8"
                })
                response.end("{\"error\":\"BadRequest\"}")
                return
            try
                handler = route.handler
                if not routeMissing(handler)
                    result = route.handler(input)
                    sendResult(response, result)
                    return
                module = route.module
                if not routeMissing(module)
                    result = module[route.func](input)
                    sendResult(response, result)
                    return
                moduleFile = resolveModule(appRoot, route.mod)
                import_module(moduleFile).then((module)
                    capture input, response, route
                    result = module[route.func](input)
                    sendResult(response, result)
                ).catch((error)
                    capture response, log, request
                    log.err("${request.method} ${request.url}: handler failed")
                    response.writeHead(500, {
                        "Content-Type": "application/json; charset=utf-8"
                    })
                    response.end("{\"error\":\"InternalServerError\"}")
                )
            catch error
                log.err("${request.method} ${request.url}: handler could not be loaded")
                response.writeHead(500, {
                    "Content-Type": "application/json; charset=utf-8"
                })
                response.end("{\"error\":\"InternalServerError\"}")
        )
    )
    server.on("error", (error)
        capture log
        log.err("HTTP server error")
    )
    server.listen(configuration.port, configuration.host)
    return server
