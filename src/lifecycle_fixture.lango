export registered(input)
export started(input)

registered(input)
    context token
    context request
    assert input.clientId == token.clientId
    assert input.url == request.path
    token.importedRegistration = true
    return null

started(input)
    context token
    token.registrationBeforeStart = token.importedRegistration == true
    token.started = true
    return null
