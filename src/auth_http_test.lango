import js global Promise
import js global fetch
import js "node:crypto" as crypto
import js "node:path" as path
import js "jose" as jose
import js global Date
import js global Math
import js global globalThis as host
import "./server"
    start(configuration, routes)
import "./tokens"
    class TokenService
import "./auth_fixture"
    allow(path, input)


export main(args)

class Harness
    properties
        service
        tracker
        key
    methods
        begin()
        listening(completion)
        request(path, token, input = null)
        stop()

Harness(tokens = true)
    @tokens = tokens

Harness:begin()
    @key = crypto/randomBytes(32)
    @service = new TokenService({
        issuer: "http-test"
        audience: "http-test"
        activeKeyId: "test"
        keys: {
            test: @key
        }
    })
    routes = [{
        path: "/private"
        handler: privateHandler
    }, {
        path: "/login"
        handler: loginHandler
        anonymous: true
    }, {
        path: "/boom"
        handler: brokenHandler
    }, {
        path: "/failed-login"
        handler: failedLogin
        anonymous: true
    }, {
        path: "/expire"
        handler: expireHandler
    }]
    routes.add({
        path: "/auth/allow"
        handler: privateHandler
        auth: allowPolicy
    })
    routes.add({
        path: "/auth/deny"
        handler: privateHandler
        auth: denyPolicy
    })
    routes.add({
        path: "/auth/public-deny"
        handler: privateHandler
        anonymous: true
        auth: denyPolicy
    })
    routes.add({
        path: "/auth/reject"
        handler: privateHandler
        auth: rejectPolicy
    })
    routes.add({
        path: "/auth/invalid"
        handler: privateHandler
        auth: invalidPolicy
    })
    routes.add({
        path: "/auth/async"
        handler: privateHandler
        auth: asyncPolicy
    })
    routes.add({
        path: "/auth/module"
        handler: privateHandler
        auth: {
            module: new Policy()
            function: "check"
        }
    })
    routes.add({
        path: "/auth/external"
        handler: privateHandler
        auth: {
            module: path.resolve(".test-output/auth_fixture.mjs")
            function: "allow"
        }
    })
    @tracker = new HandlerTracker()
    for routes as route
        if route.handler == privateHandler
            route.handler = trackedHandler(@tracker)
    service = @service
    if !@tokens
        service = null
    server = start({
        host: "127.0.0.1"
        port: 0
        appRoot: "."
        tokenService: service
    }, routes)
    @server = server
    harness = this
    ready = new Promise((resolve, reject)
        capture server
        capture harness
        register(server, harness, resolve, reject)
    )
    return ready

register(server, harness, resolve, reject)
    completion = {
        resolve: resolve
        reject: reject
    }
    server.once("listening", ()
        capture harness
        capture completion
        harness.listening(completion)
    )
    server.once("error", (error)
        capture completion
        completion.reject(error)
    )

Harness:listening(completion)
    address = @server.address()
    @url = "http://127.0.0.1:${address.port}"
    completion.resolve(this)

Harness:request(path, token, input = null)
    if input == null
        input = {
        }
    headers = {
        "Content-Type": "application/json"
    }
    if token != null
        headers.Authorization = "Bearer ${token}"
    url = @url
    return fetch("${url}${path}", {
        method: "POST"
        headers: headers
        body: to_json(input)
    })

Harness:stop()
    @server.close()
    @server.closeAllConnections()

class HandlerTracker
    properties
        calls
    methods
        invoke(input)

HandlerTracker()
    @calls = 0

HandlerTracker:invoke(input)
    @calls++
    return privateHandler(input)

trackedHandler(tracker)
    return (input)
        capture tracker
        return tracker.invoke(input)

loginHandler(input)
    context token
    token.auth = true
    token.sessionStartedAt = 0
    token.sessionExpiresAt = 0
    return {
        ok: true
    }

privateHandler(input)
    context token
    return {
        auth: token.auth
        clientId: token.clientId
    }

brokenHandler(input)
    throw "ExpectedHandlerFailure"

failedLogin(input)
    context token
    token.auth = true
    throw "ExpectedLoginFailure"

expireHandler(input)
    context token
    deadline = token.sessionExpiresAt
    frozen = ()
        capture deadline
        return deadline * 1000
    replaceNow(frozen)
    return {
        ok: true
    }

replaceNow(callback)
    host.Date.now = callback

allowPolicy(path, input)
    context request
    context token
    assert request.path == path
    assert is_object(input)
    token.policyChecked = true
    token.sessionStartedAt = 0
    token.sessionExpiresAt = 0
    return true

denyPolicy(path, input)
    context token
    token.auth = false
    token.deniedChange = "must-not-persist"
    return false

rejectPolicy(path, input)
    return Promise/reject("ExpectedAuthFailure")

invalidPolicy(path, input)
    return 0

asyncPolicy(path, input)
    context request
    context token
    return Promise/resolve().then(()
        capture request
        capture token
        capture path
        assert request.path == path
        token.asyncChecked = "yes"
        return allowedResult()
    )

allowedResult()
    return true

class Policy
    methods
        check(path, input)

Policy()
    @path = "/auth/module"

Policy:check(path, input)
    context token
    assert path == @path
    token.moduleChecked = true
    return true

main(args)
    harness = new Harness()
    return harness.begin().then((ready)
        capture harness
        return checkMissing(harness)
    ).finally(()
        capture harness
        harness.stop()
    ).then(()
        return checkLegacyDispatch()
    )

checkLegacyDispatch()
    harness = new Harness(false)
    return harness.begin().then((ready)
        capture harness
        return legacyRequest(harness)
    ).finally(()
        capture harness
        harness.stop()
    )

legacyRequest(harness)
    return harness.request("/private", null).then((response)
        capture harness
        assert response.status == 200
        assert harness.tracker.calls == 1
        return legacyDenial(harness)
    )

legacyDenial(harness)
    return harness.request("/auth/deny", null).then((response)
        capture harness
        assert response.status == 403
        assert harness.tracker.calls == 1
        println("PASS legacy dispatch invokes once and still enforces custom authorization")
    )

checkMissing(harness)
    return harness.request("/private", null).then((response)
        capture harness
        assert response.status == 401
        return checkStart(harness)
    )

checkStart(harness)
    return harness.request("/_lango/start", null).then((response)
        capture harness
        assert response.status == 200
        token = response.headers.get("X-Lango-Token")
        return checkAnonymous(harness, token)
    )

checkAnonymous(harness, token)
    return harness.request("/private", token).then((response)
        capture harness
        capture token
        assert response.status == 401
        return checkFailedLogin(harness, token)
    )

checkFailedLogin(harness, token)
    return harness.request("/failed-login", token).then((response)
        capture harness
        capture token
        assert response.status == 500
        renewed = response.headers.get("X-Lango-Token")
        return failedLoginClaims(harness, token, renewed)
    )

failedLoginClaims(harness, token, renewed)
    return harness.service.verify(renewed).then((claims)
        capture harness
        capture token
        assert !claims.auth
        return checkLogin(harness, token)
    )

checkLogin(harness, token)
    return harness.request("/login", token).then((response)
        capture harness
        assert response.status == 200
        authenticated = response.headers.get("X-Lango-Token")
        return checkAuthenticated(harness, authenticated)
    )

checkAuthenticated(harness, token)
    return harness.request("/private", token).then((response)
        capture harness
        capture token
        assert response.status == 200
        return checkAuthCases(harness, token, 0)
    )

authCases()
    return [{
        path: "/auth/allow"
        status: 200
    }, {
        path: "/auth/deny"
        status: 403
    }, {
        path: "/auth/public-deny"
        status: 403
    }, {
        path: "/auth/reject"
        status: 500
    }, {
        path: "/auth/invalid"
        status: 500
    }, {
        path: "/auth/async"
        status: 200
    }, {
        path: "/auth/module"
        status: 200
    }, {
        path: "/auth/external"
        status: 200
    }]

checkAuthCases(harness, token, index)
    cases = authCases()
    if index == cases.length
        println("PASS auth callbacks: sync, async, module receiver, imported module, 403 and 500")
        return checkFailure(harness, token)
    expected = cases[index]
    previousCalls = harness.tracker.calls
    return harness.request(expected.path, token).then((response)
        capture harness
        capture token
        capture index
        capture expected
        capture previousCalls
        if response.status != expected.status
            throw "${expected.path}: expected ${expected.status}, received ${response.status}"
        assertHandlerCalls(harness, expected, previousCalls)
        renewed = response.headers.get("X-Lango-Token")
        return verifyAuthCase(harness, token, index, expected, renewed)
    )

assertHandlerCalls(harness, expected, previousCalls)
    calls = previousCalls
    if expected.status == 200
        calls++
    assert harness.tracker.calls == calls
    return null

verifyAuthCase(harness, token, index, expected, renewed)
    return harness.service.verify(renewed).then((claims)
        capture harness
        capture token
        capture index
        capture expected
        assertPolicyClaims(claims, expected.path)
        return checkAuthCases(harness, token, index + 1)
    )

assertPolicyClaims(claims, path)
    assert claims.auth
    assert claims.deniedChange == null
    if path == "/auth/allow"
        assert claims.policyChecked
    if path == "/auth/async"
        assert claims.asyncChecked == "yes"
    if path == "/auth/module"
        assert claims.moduleChecked
    if path == "/auth/external"
        assert claims.externalChecked

checkFailure(harness, token)
    return harness.request("/boom", token).then((response)
        capture harness
        capture token
        assert response.status == 500
        return checkTampering(harness, token)
    )

checkTampering(harness, token)
    return harness.request("/login", "${token}x").then((response)
        capture harness
        capture token
        assert response.status == 401
        return checkRestart(harness, token)
    )

checkRestart(harness, token)
    return harness.service.verify(token).then((previous)
        capture harness
        capture token
        return restartWithIdentity(harness, token, previous)
    )

restartWithIdentity(harness, token, previous)
    return harness.request("/_lango/start", token).then((response)
        capture harness
        capture previous
        assert response.status == 200
        restarted = response.headers.get("X-Lango-Token")
        return checkRestartedClaims(harness, previous, restarted)
    )

checkRestartedClaims(harness, previous, token)
    return harness.service.verify(token).then((claims)
        capture previous
        capture harness
        assert claims.clientId == previous.clientId
        assert claims.sessionId != previous.sessionId
        assert !claims.auth
        println("PASS HTTP bootstrap, bearer auth, protected routes, renewal, handler errors and restart identity")
        return checkAbsoluteExpiry(harness)
    )

checkAbsoluteExpiry(harness)
    now = Math/floor(Date/now() / 1000)
    signer = new jose/SignJWT({
        clientId: "absolute-client"
        sessionId: "expired-session"
        auth: true
        sessionStartedAt: now - 60
        sessionExpiresAt: now - 1
    })
    signer.setProtectedHeader({
        alg: "HS256"
        typ: "lango+jwt"
        kid: "test"
    })
    signer.setIssuer("http-test")
    signer.setAudience("http-test")
    signer.setIssuedAt()
    signer.setExpirationTime("15m")
    signer.setJti("absolute-expiry")
    return signer.sign(harness.key).then((token)
        capture harness
        return expiredRequests(harness, token)
    )

expiredRequests(harness, token)
    checks = [harness.request("/private", token), harness.request("/login", token), harness.request("/_lango/ping", null, {
        forms: [{
            formId: "profile"
            token: token
        }]
    })]
    return Promise/all(checks).then((responses)
        capture harness
        capture token
        for responses as response
            assert response.status == 401
            assert response.headers.get("X-Lango-Token") == null
        return harness.request("/_lango/start", token)
    ).then((response)
        capture harness
        assert response.status == 200
        return harness.service.verify(response.headers.get("X-Lango-Token"))
    ).then((claims)
        capture harness
        assert claims.clientId == "absolute-client"
        assert claims.sessionId != "expired-session"
        assert !claims.auth
        assert claims.sessionExpiresAt - claims.sessionStartedAt == 28800
        println("PASS absolute expiry rejects private, anonymous and ping requests; bootstrap recovers only client identity")
        return checkExpiredResponse(harness)
    )

checkExpiredResponse(harness)
    original = host.Date.now
    return harness.service.sign({
        auth: true
    }).then((token)
        capture harness
        return harness.request("/expire", token)
    ).then((response)
        assert response.status == 401
        assert response.headers.get("X-Lango-Token") == null
        assert response.headers.get("WWW-Authenticate") == "Bearer"
        println("PASS expiry during handler execution returns 401 without renewing the expired session")
    ).finally(()
        capture original
        replaceNow(original)
    )
