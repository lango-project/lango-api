import js "node:fs" as fs
import "./authorization"
    createAuth(spec)
    resolveAuth(spec, definitions)
import "./lifecycle"
    createLifecycle(spec)
    addLifecycle(handlers, options)

export loadRoutes(apiFile)
export loadApi(apiFile)
export apiFromXml(xml)
export findRoute(routes, requestPath)
export endpointFromTag(tag)
export createEndpoint(options)
export addRoute(routes, endpoint)
export routeMissing(route)
export routesFromXml(xml)
export anonymousValue(value)

anonymousValue(value)
    if value == null
        return null
    if value == true or value == "true"
        return true
    if value == false or value == "false"
        return false
    throw "ApiAnonymousMustBeBoolean"

endpointFromTag(tag)
    validateAttributes(tag, ["path", "mod", "func", "anonymous", "auth"])
    return createEndpoint({
        path: tag.path,
        module: tag.mod,
        function: tag.func,
        anonymous: tag.anonymous,
        auth: tag.auth
    })

createEndpoint(options)
    if not is_object(options)
        throw "ApiEndpointMustBeMap"
    path = options.path
    mod = options.module
    func = options.function
    if !is_string(path) or path == "" or func == null
        throw "ApiEndpointRequiresPathAndFunc"
    if path[0] != "/"
        throw "ApiEndpointPathMustStartWithSlash"
    if path.includes("*") and not path.endsWith("/*")
        throw "ApiWildcardMustBeTrailingSlashStar"
    if path.indexOf("*") != path.lastIndexOf("*")
        throw "ApiWildcardMustBeTrailingSlashStar"
    moduleName = null
    moduleValue = mod
    if is_string(mod)
        moduleName = mod
        moduleValue = null
    functionName = null
    handler = func
    if is_string(func)
        functionName = func
        handler = null
    return {
        path: path,
        mod: moduleName,
        func: functionName,
        module: moduleValue,
        handler: handler,
        anonymous: anonymousValue(options.anonymous),
        auth: options.auth
    }

addRoute(routes, endpoint)
    if endpoint.anonymous == null
        endpoint.anonymous = false
    if endpoint.func != null and endpoint.mod == null and endpoint.module == null
        throw "ApiEndpointStringFunctionRequiresModule"
    for routes as existing
        if existing.path == endpoint.path
            throw "ApiDuplicateEndpointPath"
    routes.add(endpoint)
    return endpoint

loadRoutes(apiFile)
    api = loadApi(apiFile)
    return api.routes

loadApi(apiFile)
    if not fs.existsSync(apiFile)
        throw "ApiConfigFileNotFound: ${apiFile}"
    xml = fs.readFileSync(apiFile, "utf8")
    try
        return apiFromXml(xml)
    catch error
        throw "ApiConfigInvalid: ${apiFile}: ${error}"

routesFromXml(xml)
    api = apiFromXml(xml)
    return api.routes

apiFromXml(xml)
    root = xml2obj(xml)
    if root.tag() != "api"
        throw "ApiConfigRootMustBeApi"
    validateAttributes(root, [])
    routes = []
    definitions = {}
    lifecycle = createLifecycle(null)
    for root.children() as child
        if child.tag() == "event"
            validateAttributes(child, ["name", "mod", "func"])
            if child.children().length != 0 or child.innerText().trim() != ""
                throw "ApiLifecycleEventMustBeEmpty"
            addLifecycle(lifecycle, { event: child.name, module: child.mod, function: child.func })
        if child.tag() == "auth"
            validateAttributes(child, ["name", "mod", "func"])
            name = child.name
            if !is_string(name) or name == "" or name == "__proto__" or name == "constructor" or name == "prototype"
                throw "ApiAuthRequiresValidName"
            if name in definitions
                throw "ApiDuplicateAuthName: ${name}"
            definitions[name] = createAuth({ module: child.mod, function: child.func })
    collectRoutes(root, "", null, routes, false, null)
    for routes as route
        route.auth = resolveAuth(route.auth, definitions)
    return { routes: routes, lifecycle: lifecycle }

validateAttributes(tag, allowed)
    tagName = tag.tag()
    for tag.attributes() as name: value
        if not allowed.includes(name)
            throw "ApiConfigUnknownAttribute: <${tagName}> ${name}"
    return null

collectRoutes(tag, parentPath, parentMod, routes, parentAnonymous, parentAuth)
    for tag.children() as child
        if tag.tag() == "api" and child.tag() == "auth"
            continue
        if tag.tag() == "api" and child.tag() == "event"
            continue
        if child.tag() == "group"
            validateAttributes(child, ["path", "mod", "anonymous", "auth"])
            path = child.path
            mod = child.mod
            if path == null
                path = ""
            if mod == null
                mod = parentMod
            anonymous = anonymousValue(child.anonymous)
            if anonymous == null
                anonymous = parentAnonymous
            auth = child.auth
            if auth == null
                auth = parentAuth
            collectRoutes(child, "${parentPath}${path}", mod, routes, anonymous, auth)
          else
              if child.tag() == "endpoint"
                  endpoint = endpointFromTag(child)
                  endpoint.path = "${parentPath}${endpoint.path}"
                  if endpoint.anonymous == null
                      endpoint.anonymous = parentAnonymous
                  if endpoint.auth == null
                      endpoint.auth = parentAuth
                  if endpoint.mod == null and endpoint.module == null
                      endpoint.mod = parentMod
                  if endpoint.mod == null and endpoint.module == null and endpoint.handler == null
                      throw "ApiEndpointRequiresPathModAndFunc"
                  addRoute(routes, endpoint)
                else
                    childTag = child.tag()
                    throw "ApiConfigUnknownTag: <${childTag}>"

findRoute(routes, requestPath)
    best = null
    bestLength = 0
    for routes as route
        if route.path == requestPath
            return route
        if route.path.endsWith("/*")
            prefix = route.path.slice(0, -1)
            if requestPath.startsWith(prefix) and prefix.length > bestLength
                best = route
                bestLength = prefix.length
    return best

routeMissing(route)
    return route == null

test "exact routes win over the longest wildcard independently of registration order"
    routes = routesFromXml("<api><endpoint path=\"/app/*\" mod=\"ui\" func=\"handle\" /><endpoint path=\"/app/admin/*\" mod=\"admin\" func=\"handle\" /><endpoint path=\"/app/admin/save\" mod=\"save\" func=\"handle\" /></api>")
    exact = findRoute(routes, "/app/admin/save")
    nested = findRoute(routes, "/app/admin/edit")
    assert exact.mod == "save"
    assert nested.mod == "admin"
    assert routeMissing(findRoute(routes, "/application/test"))

test "endpoint XML requires its route fields"
    endpoint = endpointFromTag(xml2obj("<endpoint path=\"/math/add\" mod=\"math\" func=\"add\" />"))
    assert endpoint.path == "/math/add"
    assert endpoint.mod == "math"
    assert endpoint.func == "add"

test "endpoint XML rejects a relative path"
    try
        endpointFromTag(xml2obj("<endpoint path=\"math/add\" mod=\"math\" func=\"add\" />"))
        assert false
    catch error
        assert error == "ApiEndpointPathMustStartWithSlash"

test "endpoint maps retain direct module and handler references"
    handler = (input)
        return input
    module = { add: handler }
    endpoint = createEndpoint({ path: "/direct", module: module, function: handler })
    assert endpoint.module == module
    assert endpoint.handler == handler

test "groups inherit path and module"
    routes = routesFromXml("<api><group path=\"/math\" mod=\"math\"><endpoint path=\"/add\" func=\"add\" /></group></api>")
    assert routes[0].path == "/math/add"
    assert routes[0].mod == "math"

test "anonymous flags inherit and can be overridden"
    routes = routesFromXml("<api><group path=\"/public\" mod=\"app\" anonymous=\"true\"><endpoint path=\"/open\" func=\"open\" /><endpoint path=\"/private\" func=\"private\" anonymous=\"false\" /></group></api>")
    assert routes[0].anonymous
    assert !routes[1].anonymous

test "api XML rejects an unknown tag and attribute"
    try
        routesFromXml("<api><unknown /></api>")
        assert false
    catch error
        assert error == "ApiConfigUnknownTag: <unknown>"
    try
        routesFromXml("<api><endpoint path=\"/health\" mod=\"health\" func=\"check\" typo=\"true\" /></api>")
        assert false
    catch error
        assert error == "ApiConfigUnknownAttribute: <endpoint> typo"

test "XML auth definitions resolve across group inheritance and declaration order"
    routes = routesFromXml("<api><group path=\"/private\" mod=\"app\" auth=\"check\"><endpoint path=\"/first\" func=\"first\" /></group><auth name=\"check\" mod=\"security\" func=\"check\" /></api>")
    assert routes[0].auth.module == "security"
    assert routes[0].auth.function == "check"
    try
        routesFromXml("<api><endpoint path=\"/private\" mod=\"app\" func=\"run\" auth=\"unknown\" /></api>")
        assert false
    catch error
        assert error == "ApiUnknownAuth: unknown"

test "XML lifecycle events are separate from routes and preserve handler references"
    api = apiFromXml("<api><event name=\"register\" mod=\"@shop/session\" func=\"registerClient\" /><endpoint path=\"/health\" mod=\"app\" func=\"health\" /><event name=\"start\" mod=\"@shop/session\" func=\"startSession\" /></api>")
    assert api.routes.length == 1
    assert api.routes[0].path == "/health"
    assert api.lifecycle.register.module == "@shop/session"
    assert api.lifecycle.register.function == "registerClient"
    assert api.lifecycle.start.function == "startSession"
    assert routesFromXml("<api><event name=\"start\" mod=\"app\" func=\"start\" /></api>").length == 0

test "XML lifecycle events reject invalid definitions and group nesting"
    cases = []
    cases.add({ xml: "<api><event name=\"ping\" mod=\"app\" func=\"ping\" /></api>", error: "ApiUnknownLifecycleEvent" })
    cases.add({ xml: "<api><event name=\"start\" func=\"start\" /></api>", error: "ApiLifecycleRequiresModuleAndFunction" })
    cases.add({ xml: "<api><event name=\"start\" mod=\"app\" /></api>", error: "ApiLifecycleRequiresModuleAndFunction" })
    cases.add({ xml: "<api><event name=\"start\" mod=\"app\" func=\"start\" typo=\"true\" /></api>", error: "ApiConfigUnknownAttribute: <event> typo" })
    cases.add({ xml: "<api><event name=\"start\" mod=\"app\" func=\"start\">text</event></api>", error: "ApiLifecycleEventMustBeEmpty" })
    cases.add({ xml: "<api><event name=\"start\" mod=\"app\" func=\"start\"><child /></event></api>", error: "ApiLifecycleEventMustBeEmpty" })
    cases.add({ xml: "<api><event name=\"start\" mod=\"app\" func=\"start\" /><event name=\"start\" mod=\"app\" func=\"other\" /></api>", error: "ApiDuplicateLifecycleEvent: start" })
    cases.add({ xml: "<api><group path=\"/app\"><event name=\"start\" mod=\"app\" func=\"start\" /></group></api>", error: "ApiConfigUnknownTag: <event>" })
    for cases as expected
        try
            apiFromXml(expected.xml)
            assert false
        catch error
            assert error == expected.error
