import js "node:fs" as fs

export loadRoutes(apiFile)
export findRoute(routes, requestPath)
export endpointFromTag(tag)
export createEndpoint(options)
export addRoute(routes, endpoint)
export routeMissing(route)
export routesFromXml(xml)

endpointFromTag(tag)
    validateAttributes(tag, ["path", "mod", "func"])
    return createEndpoint({
        path: tag.path,
        module: tag.mod,
        function: tag.func
    })

createEndpoint(options)
    if not is_object(options)
        throw "ApiEndpointMustBeMap"
    path = options.path
    mod = options.module
    func = options.function
    if not is_string(path) or path == "" or func == null
        throw "ApiEndpointRequiresPathAndFunc"
    if path[0] != "/"
        throw "ApiEndpointPathMustStartWithSlash"
    moduleName = null
    moduleValue = mod
    if is_string(mod)
        moduleName = mod
        moduleValue = null
    functionName = null
    handler = func
    if is_string(func)
        functionName = func
        handler = null
    return {
        path: path,
        mod: moduleName,
        func: functionName,
        module: moduleValue,
        handler: handler
    }

addRoute(routes, endpoint)
    if endpoint.func != null and endpoint.mod == null and endpoint.module == null
        throw "ApiEndpointStringFunctionRequiresModule"
    if not routeMissing(findRoute(routes, endpoint.path))
        throw "ApiDuplicateEndpointPath"
    routes.add(endpoint)
    return endpoint

loadRoutes(apiFile)
    if not fs.existsSync(apiFile)
        throw "ApiConfigFileNotFound: ${apiFile}"
    xml = fs.readFileSync(apiFile, "utf8")
    try
        return routesFromXml(xml)
    catch error
        throw "ApiConfigInvalid: ${apiFile}: ${error}"

routesFromXml(xml)
    root = xml2obj(xml)
    if root.tag() != "api"
        throw "ApiConfigRootMustBeApi"
    validateAttributes(root, [])
    routes = []
    collectRoutes(root, "", null, routes)
    return routes

validateAttributes(tag, allowed)
    tagName = tag.tag()
    for tag.attributes() as name: value
        if not allowed.includes(name)
            throw "ApiConfigUnknownAttribute: <${tagName}> ${name}"
    return null

collectRoutes(tag, parentPath, parentMod, routes)
    for tag.children() as child
        if child.tag() == "group"
            validateAttributes(child, ["path", "mod"])
            path = child.path
            mod = child.mod
            if path == null
                path = ""
            if mod == null
                mod = parentMod
            collectRoutes(child, parentPath + path, mod, routes)
          else
              if child.tag() == "endpoint"
                  endpoint = endpointFromTag(child)
                  endpoint.path = parentPath + endpoint.path
                  if endpoint.mod == null and endpoint.module == null
                      endpoint.mod = parentMod
                  if endpoint.mod == null and endpoint.module == null and endpoint.handler == null
                      throw "ApiEndpointRequiresPathModAndFunc"
                  addRoute(routes, endpoint)
                else
                    childTag = child.tag()
                    throw "ApiConfigUnknownTag: <${childTag}>"

findRoute(routes, requestPath)
    for routes as route
        if route.path == requestPath
            return route
    return null

routeMissing(route)
    return route == null

test "endpoint XML requires its route fields"
    endpoint = endpointFromTag(xml2obj("<endpoint path=\"/math/add\" mod=\"math\" func=\"add\" />"))
    assert endpoint.path == "/math/add"
    assert endpoint.mod == "math"
    assert endpoint.func == "add"

test "endpoint XML rejects a relative path"
    try
        endpointFromTag(xml2obj("<endpoint path=\"math/add\" mod=\"math\" func=\"add\" />"))
        assert false
    catch error
        assert error == "ApiEndpointPathMustStartWithSlash"

test "endpoint maps retain direct module and handler references"
    handler = (input)
        return input
    module = { add: handler }
    endpoint = createEndpoint({ path: "/direct", module: module, function: handler })
    assert endpoint.module == module
    assert endpoint.handler == handler

test "groups inherit path and module"
    routes = routesFromXml("<api><group path=\"/math\" mod=\"math\"><endpoint path=\"/add\" func=\"add\" /></group></api>")
    assert routes[0].path == "/math/add"
    assert routes[0].mod == "math"

test "api XML rejects an unknown tag and attribute"
    try
        routesFromXml("<api><unknown /></api>")
        assert false
    catch error
        assert error == "ApiConfigUnknownTag: <unknown>"
    try
        routesFromXml("<api><endpoint path=\"/health\" mod=\"health\" func=\"check\" typo=\"true\" /></api>")
        assert false
    catch error
        assert error == "ApiConfigUnknownAttribute: <endpoint> typo"
