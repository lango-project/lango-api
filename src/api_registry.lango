import js "node:fs" as fs

export loadRoutes(apiFile)
export findRoute(routes, requestPath)
export endpointFromTag(tag)
export routeMissing(route)
export routesFromXml(xml)

endpointFromTag(tag)
    path = tag.path
    mod = tag.mod
    func = tag.func
    if path == null or func == null
        throw "ApiEndpointRequiresPathAndFunc"
    if path[0] != "/"
        throw "ApiEndpointPathMustStartWithSlash"
    return {
        path: path,
        mod: mod,
        func: func
    }

loadRoutes(apiFile)
    if fs.existsSync(apiFile) == false
        throw "ApiFileNotFound"
    xml = fs.readFileSync(apiFile, "utf8")
    return routesFromXml(xml)

routesFromXml(xml)
    root = xml2obj(xml)
    routes = []
    collectRoutes(root, "", null, routes)
    return routes

collectRoutes(tag, parentPath, parentMod, routes)
    for tag.children() as child
        if child.tag() == "group"
            path = child.path
            mod = child.mod
            if path == null
                path = ""
            if mod == null
                mod = parentMod
            collectRoutes(child, parentPath + path, mod, routes)
        if child.tag() == "endpoint"
            endpoint = endpointFromTag(child)
            endpoint.path = parentPath + endpoint.path
            if endpoint.mod == null
                endpoint.mod = parentMod
            if endpoint.mod == null
                throw "ApiEndpointRequiresPathModAndFunc"
            if routeMissing(findRoute(routes, endpoint.path)) == false
                throw "ApiDuplicateEndpointPath"
            routes.add(endpoint)

findRoute(routes, requestPath)
    for routes as route
        if route.path == requestPath
            return route
    return null

routeMissing(route)
    return route == null

test "endpoint XML requires its route fields"
    endpoint = endpointFromTag(xml2obj("<endpoint path=\"/math/add\" mod=\"math\" func=\"add\" />"))
    assert endpoint.path == "/math/add"
    assert endpoint.mod == "math"
    assert endpoint.func == "add"

test "endpoint XML rejects a relative path"
    try
        endpointFromTag(xml2obj("<endpoint path=\"math/add\" mod=\"math\" func=\"add\" />"))
        assert false
    catch error
        assert error == "ApiEndpointPathMustStartWithSlash"

test "groups inherit path and module"
    routes = routesFromXml("<api><group path=\"/math\" mod=\"math\"><endpoint path=\"/add\" func=\"add\" /></group></api>")
    assert routes[0].path == "/math/add"
    assert routes[0].mod == "math"
