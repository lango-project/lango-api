import js global Promise
import js global Date
import js global fetch
import js global AbortSignal
import js "node:crypto" as crypto
import js "node:timers/promises" as timers
import "./server"
    start(configuration, routes)
import "./tokens"
    class TokenService
    class MemorySessionRevocations

export main(args)

class Store
    properties
        failReads
        failWrites
        expiresAt
        reads
        revokeDuringSigning
    methods
        isRevoked(sessionId)
        revoke(sessionId, expiresAt)

Store()
    @memory = new MemorySessionRevocations()
    @failReads = false
    @failWrites = false
    @reads = 0
    @revokeDuringSigning = false

Store:isRevoked(sessionId)
    @reads++
    if @revokeDuringSigning and @reads == 2
        @memory.revoke(sessionId, Date/now() / 1000 + 900)
    if @failReads
        return Promise/reject("ExpectedStoreFailure")
    return Promise/resolve(@memory.isRevoked(sessionId))

Store:revoke(sessionId, expiresAt)
    if @failWrites
        return Promise/reject("ExpectedStoreFailure")
    @expiresAt = expiresAt
    return Promise/resolve(@memory.revoke(sessionId, expiresAt))

class Harness
    properties
        service
        store
    methods
        begin()
        listening(completion)
        request(path, token, input = null)
        stop()

Harness:begin()
    @store = new Store()
    @service = new TokenService({
        issuer: "logout-test"
        audience: "logout-test"
        activeKeyId: "current"
        keys: {
            current: crypto/randomBytes(32)
        }
        revocations: @store
    })
    server = start({
        host: "127.0.0.1"
        port: 0
        appRoot: "."
        tokenService: @service
    }, [{
        path: "/private"
        handler: privateHandler
    }, {
        path: "/logout"
        handler: logoutHandler
    }, {
        path: "/failed-logout"
        handler: failedLogoutHandler
    }, {
        path: "/delayed-logout"
        handler: delayedLogoutHandler
    }])
    @server = server
    harness = this
    pending = new Promise((resolve, reject)
        capture harness
        capture server
        listen(harness, server, resolve, reject)
    )
    return pending

listen(harness, server, resolve, reject)
    completion = {
        resolve: resolve
        reject: reject
    }
    server.once("listening", ()
        capture harness
        capture completion
        harness.listening(completion)
    )
    server.once("error", (error)
        capture completion
        completion.reject(error)
    )

Harness:listening(completion)
    address = @server.address()
    @url = "http://127.0.0.1:${address.port}"
    completion.resolve(this)

Harness:request(path, token, input = null)
    headers = {
        "Content-Type": "application/json"
    }
    if token != null
        headers.Authorization = "Bearer ${token}"
    url = @url
    return fetch("${url}${path}", {
        method: "POST"
        headers: headers
        body: to_json(input)
        signal: AbortSignal/timeout(5000)
    })

Harness:stop()
    @server.close()
    @server.closeAllConnections()

privateHandler(input)
    return {
        ok: true
    }

logoutHandler(input)
    context response
    context token
    token.sessionId = "other-session"
    response.logout()
    response.logout()
    return {
        ok: true
    }

failedLogoutHandler(input)
    context response
    response.logout()
    throw "ExpectedFailureAfterLogout"

delayedLogoutHandler(input)
    context response
    response.logout()
    return timers/setTimeout(20, {
        loggedOut: true
    })

main(args)
    checkMemoryExpiry()
    harness = new Harness()
    return harness.begin().then((ready)
        capture harness
        return issueForms(harness)
    ).then((tokens)
        capture harness
        return checkLogout(harness, tokens)
    ).finally(()
        capture harness
        harness.stop()
    ).then(()
        return checkSigningRace()
    )

checkMemoryExpiry()
    store = new MemorySessionRevocations()
    now = Date/now() / 1000
    store.revoke("expired", now - 1)
    assert !store.isRevoked("expired")
    store.revoke("active", now + 30)
    store.revoke("active", now + 10)
    assert store.isRevoked("active")
    assert !store.isRevoked("unrelated")
    return null

issueForms(harness)
    left = issue(harness.service, "session", "left")
    right = issue(harness.service, "session", "right")
    other = issue(harness.service, "other-session", "other")
    return Promise/all([left, right, other])

issue(service, sessionId, formId)
    return service.sign({
        clientId: "stable-client"
        sessionId: sessionId
        formId: formId
        seqno: 7
        auth: true
    })

checkLogout(harness, tokens)
    return harness.request("/_lango/logout", tokens[0]).then((response)
        capture harness
        assert response.status == 200
        assertNoToken(response)
        assert harness.store.expiresAt >= Date/now() / 1000 + 900
        return response.json()
    ).then((body)
        capture harness
        capture tokens
        assert body.loggedOut
        return checkRevoked(harness, tokens)
    )

assertNoToken(response)
    assert response.headers.get("X-Lango-Token") == null
    assert response.headers.get("Cache-Control") == "no-store"
    return null

checkRevoked(harness, tokens)
    checks = [harness.request("/private", tokens[0]), harness.request("/private", tokens[1]), harness.request("/_lango/logout", tokens[0]), harness.request("/_lango/logout", null), harness.request("/_lango/ping", null, {
        forms: [{
            formId: "right"
            token: tokens[1]
        }]
    })]
    return Promise/all(checks).then((responses)
        capture harness
        capture tokens
        for responses as response
            assert response.status == 401
            assert response.headers.get("X-Lango-Token") == null
        return harness.request("/private", tokens[2])
    ).then((response)
        capture harness
        capture tokens
        assert response.status == 200
        return checkRestart(harness, tokens[0])
    )

checkRestart(harness, token)
    return harness.request("/_lango/start", token).then((response)
        capture harness
        assert response.status == 200
        return harness.service.verify(response.headers.get("X-Lango-Token"))
    ).then((claims)
        capture harness
        assert claims.clientId == "stable-client"
        assert claims.sessionId != "session"
        assert !claims.auth
        return checkContextLogout(harness)
    )

checkContextLogout(harness)
    return issue(harness.service, "context-session", "form").then((token)
        capture harness
        return contextLogout(harness, token)
    )

contextLogout(harness, token)
    return harness.request("/logout", token).then((response)
        capture harness
        capture token
        assert response.status == 200
        assertNoToken(response)
        return harness.request("/private", token)
    ).then((response)
        capture harness
        assert response.status == 401
        return issue(harness.service, "other-session", "other")
    ).then((token)
        capture harness
        return harness.request("/private", token)
    ).then((response)
        capture harness
        assert response.status == 200
        return checkFailureAfterLogout(harness)
    )

checkFailureAfterLogout(harness)
    return issue(harness.service, "failed-session", "form").then((token)
        capture harness
        return failedLogout(harness, token)
    )

failedLogout(harness, token)
    return harness.request("/failed-logout", token).then((response)
        capture harness
        capture token
        assert response.status == 500
        assertNoToken(response)
        return harness.request("/private", token)
    ).then((response)
        capture harness
        assert response.status == 401
        return checkStoreFailure(harness)
    )

checkStoreFailure(harness)
    return issue(harness.service, "store-session", "form").then((token)
        capture harness
        return failedStoreLogout(harness, token)
    )

failedStoreLogout(harness, token)
    harness.store.failWrites = true
    return harness.request("/delayed-logout", token).then((response)
        capture harness
        capture token
        assert response.status == 500
        assertNoToken(response)
        harness.store.failWrites = false
        harness.store.failReads = true
        return harness.request("/private", token)
    ).then((response)
        assert response.status == 401
        assert response.headers.get("X-Lango-Token") == null
        println("PASS session logout: all forms revoked, other sessions isolated, restart anonymous, context identity protected and store failures closed")
    )

checkSigningRace()
    store = new Store()
    store.revokeDuringSigning = true
    service = configuredService(store, crypto/randomBytes(32))
    return issue(service, "race-session", "form").then((token)
        throw "UnexpectedTokenAfterRevocation"
    ).catch((error)
        assert error == "ApiInvalidToken"
        return checkSharedStore()
    )

configuredService(store, key)
    service = new TokenService({
        issuer: "shared-test"
        audience: "shared-test"
        activeKeyId: "current"
        keys: {
            current: key
        }
        revocations: store
    })
    return service

checkSharedStore()
    store = new Store()
    key = crypto/randomBytes(32)
    first = configuredService(store, key)
    second = configuredService(store, key)
    return issue(first, "shared-session", "form").then((token)
        capture first
        capture second
        return revokeShared(first, second, token)
    )

revokeShared(first, second, token)
    return second.verify(token).then((claims)
        capture first
        return first.revoke(claims)
    ).then(()
        capture second
        capture token
        return expectRevoked(second, token)
    ).then(()
        capture first
        return expectSigningDenied(first)
    ).then(()
        println("PASS shared revocation store and signing checks before and after asynchronous signing")
    )

expectSigningDenied(service)
    return issue(service, "shared-session", "new-form").then((token)
        throw "UnexpectedRevokedSessionSigning"
    ).catch((error)
        assert error == "ApiInvalidToken"
    )

expectRevoked(service, token)
    return service.verify(token).then((claims)
        throw "UnexpectedRevokedTokenAcceptance"
    ).catch((error)
        assert error == "ApiInvalidToken"
    )
