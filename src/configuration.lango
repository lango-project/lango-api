import js "node:fs" as fs
import js "node:path" as path
import js "node:process" as process

export defaultConfiguration(applicationName)
export loadConfiguration(applicationName, configurationFile, paths)
export applyEnvironmentConfiguration(configuration, environment)
export applyOptionConfiguration(configuration, options)
export validateConfiguration(configuration)
export workersEnabled(configuration)
export validateWorkers(configuration)

parsePort(value)
    try
        port = to_js_number($(value))
    catch error
        throw "ApiPortMustBeAnIntegerBetween1And65535"
    if port < 1 or port > 65535 or port % 1 != 0
        throw "ApiPortMustBeAnIntegerBetween1And65535"
    return port

defaultConfiguration(applicationName)
    return {
        applicationName: applicationName
        host: "127.0.0.1"
        port: 3000
        jwt: null
        state: null
        workers: null
    }

applyXmlConfiguration(configuration, xml)
    conf = xml2obj(xml)
    if conf.tag() != "conf"
        throw "ApiConfigurationRootMustBeConf"
    jwtSeen = false
    stateSeen = false
    workersSeen = false
    for conf.children() as child
        if child.tag() == "workers"
            if workersSeen
                throw "ApiDuplicateWorkersConfiguration"
            workersSeen = true
            applyXmlWorkers(configuration, child)
        if child.tag() == "jwt"
            if jwtSeen
                throw "ApiDuplicateJwtConfiguration"
            jwtSeen = true
            applyXmlJwt(configuration, child)
        if child.tag() == "state"
            if stateSeen
                throw "ApiDuplicateStateConfiguration"
            stateSeen = true
            applyXmlState(configuration, child)
    http = conf.http
    configuredPaths = conf.paths
    if http != null
        if http.host != null
            configuration.host = http.host
        if http.port != null
            configuration.port = parsePort(http.port)
    if configuredPaths != null
        if configuredPaths.appRoot != null
            configuration.appRoot = configuredPaths.appRoot
        if configuredPaths.dataDir != null
            configuration.dataDir = configuredPaths.dataDir
        if configuredPaths.stateDir != null
            configuration.stateDir = configuredPaths.stateDir
        if configuredPaths.logDir != null
            configuration.logDir = configuredPaths.logDir
        if configuredPaths.apiFile != null
            configuration.apiFile = configuredPaths.apiFile
    return configuration

jwtSettings(configuration)
    if configuration.jwt == null
        configuration.jwt = {
            enabled: true
            ttlSeconds: 900
            sessionTtlSeconds: 28800
        }
    return configuration.jwt

setJwt(configuration, name, value)
    jwt = jwtSettings(configuration)
    if name == "enabled"
        if value != true and value != false and value != "true" and value != "false"
            throw "ApiJwtEnabledMustBeBoolean"
        jwt.enabled = value == true or value == "true"
      else
          if name == "ttlSeconds" or name == "sessionTtlSeconds"
              try
                  jwt[name] = to_js_number($(value))
              catch error
                  throw "ApiJwtInvalidLifetime"
            else
                jwt[name] = value
    if name == "keysFile"
        jwt.keysBaseDir = process.cwd()
    return null

setState(configuration, name, value)
    if configuration.state == null
        configuration.state = {
            backend: "sqlite"
            file: "runtime.sqlite"
            maxForms: 10000
        }
    settings = configuration.state
    parsed = value
    if name == "maxForms"
        try
            parsed = to_js_number($(value))
        catch error
            throw "ApiStateInvalidCapacity"
    settings[name] = parsed
    return null

applyXmlState(configuration, tag)
    allowed = ["backend", "file", "namespace", "maxForms"]
    setState(configuration, "backend", "sqlite")
    for tag.attributes() as name: value
        if !allowed.includes(name)
            throw "ApiStateUnknownAttribute: ${name}"
        setState(configuration, name, value)
    children = tag.children()
    if children.length > 0 or tag.innerText().trim() != ""
        throw "ApiStateConfigurationMustUseAttributes"
    return null

applyXmlJwt(configuration, tag)
    allowed = ["enabled", "issuer", "audience", "activeKeyId", "keysFile", "ttlSeconds", "sessionTtlSeconds"]
    jwtSettings(configuration)
    for tag.attributes() as name: value
        if not allowed.includes(name)
            throw "ApiJwtUnknownAttribute: ${name}"
        setJwt(configuration, name, value)
    children = tag.children()
    if children.length > 0 or tag.innerText().trim() != ""
        throw "ApiJwtConfigurationMustUseAttributes"
    return null

loadConfiguration(applicationName, configurationFile, paths)
    configuration = defaultConfiguration(applicationName)
    configuration.appRoot = paths.appRoot
    configuration.dataDir = paths.dataDir
    configuration.stateDir = paths.stateDir
    configuration.logDir = paths.logDir

    if fs.existsSync(configurationFile)
        xml = fs.readFileSync(configurationFile, "utf8")
        applyXmlConfiguration(configuration, xml)
        if configuration.jwt != null
            configuration.jwt.keysBaseDir = path.dirname(path.resolve(configurationFile))

    return configuration

applyEnvironmentConfiguration(configuration, environment)
    workers = {
        LANGO_WORKERS: "enabled"
        LANGO_WORKER_APPLICATION: "application"
        LANGO_WORKER_THREADS: "threads"
        LANGO_WORKER_MAX_QUEUE: "maxQueue"
        LANGO_WORKER_BODY_LIMIT: "bodyLimit"
        LANGO_WORKER_BODY_TIMEOUT: "bodyTimeoutMs"
        LANGO_WORKER_RATE_LIMIT: "rateLimit"
        LANGO_WORKER_RATE_WINDOW: "rateWindowMs"
        LANGO_WORKER_RATE_MAX_CLIENTS: "rateMaxClients"
        LANGO_WORKER_TIMEOUT: "requestTimeoutMs"
        LANGO_WORKER_STARTUP_TIMEOUT: "startupTimeoutMs"
        LANGO_WORKER_SHUTDOWN_TIMEOUT: "shutdownTimeoutMs"
        LANGO_WORKER_ENTRY: "workerFile"
        LANGO_WORKER_OPTIONS: "optionsFile"
    }
    for workers as variable: name
        if is_string(environment[variable])
            setWorker(configuration, name, environment[variable])
    state = {
        LANGO_STATE_BACKEND: "backend"
        LANGO_STATE_FILE: "file"
        LANGO_STATE_NAMESPACE: "namespace"
        LANGO_STATE_MAX_FORMS: "maxForms"
    }
    for state as variable: name
        if is_string(environment[variable])
            setState(configuration, name, environment[variable])
    if is_string(environment.LANGO_APP_ROOT)
        configuration.appRoot = environment.LANGO_APP_ROOT
    if is_string(environment.LANGO_DATA_DIR)
        configuration.dataDir = environment.LANGO_DATA_DIR
    if is_string(environment.LANGO_STATE_DIR)
        configuration.stateDir = environment.LANGO_STATE_DIR
    if is_string(environment.LANGO_LOG_DIR)
        configuration.logDir = environment.LANGO_LOG_DIR
    if is_string(environment.LANGO_API)
        configuration.apiFile = environment.LANGO_API
    if is_string(environment.LANGO_HOST)
        configuration.host = environment.LANGO_HOST
    if is_string(environment.LANGO_PORT)
        configuration.port = parsePort(environment.LANGO_PORT)
    mapping = {
        LANGO_JWT_ENABLED: "enabled"
        LANGO_JWT_ISSUER: "issuer"
        LANGO_JWT_AUDIENCE: "audience"
        LANGO_JWT_KEYS: "keysFile"
        LANGO_JWT_KEY_ID: "activeKeyId"
        LANGO_JWT_TTL: "ttlSeconds"
        LANGO_JWT_SESSION_TTL: "sessionTtlSeconds"
    }
    for mapping as variable: name
        if is_string(environment[variable])
            setJwt(configuration, name, environment[variable])
    return configuration

applyOptionConfiguration(configuration, options)
    workers = {
        workersEnabled: "enabled"
        workerApplication: "application"
        workerThreads: "threads"
        workerMaxQueue: "maxQueue"
        workerBodyLimit: "bodyLimit"
        workerBodyTimeout: "bodyTimeoutMs"
        workerRateLimit: "rateLimit"
        workerRateWindow: "rateWindowMs"
        workerRateMaxClients: "rateMaxClients"
        workerTimeout: "requestTimeoutMs"
        workerStartupTimeout: "startupTimeoutMs"
        workerShutdownTimeout: "shutdownTimeoutMs"
        workerEntry: "workerFile"
        workerOptions: "optionsFile"
    }
    for workers as option: name
        if options[option] != null
            setWorker(configuration, name, options[option])
    state = {
        stateBackend: "backend"
        stateFile: "file"
        stateNamespace: "namespace"
        stateMaxForms: "maxForms"
    }
    for state as option: name
        if options[option] != null
            setState(configuration, name, options[option])
    if options.appRoot != null
        configuration.appRoot = options.appRoot
    if options.dataDir != null
        configuration.dataDir = options.dataDir
    if options.stateDir != null
        configuration.stateDir = options.stateDir
    if options.logDir != null
        configuration.logDir = options.logDir
    if options.apiFile != null
        configuration.apiFile = options.apiFile
    if options.host != null
        configuration.host = options.host
    if options.port != null
        configuration.port = parsePort(options.port)
    mapping = {
        jwtEnabled: "enabled"
        jwtIssuer: "issuer"
        jwtAudience: "audience"
        jwtKeys: "keysFile"
        jwtKeyId: "activeKeyId"
        jwtTtl: "ttlSeconds"
        jwtSessionTtl: "sessionTtlSeconds"
    }
    for mapping as option: name
        if options[option] != null
            setJwt(configuration, name, options[option])
    return configuration

validateConfiguration(configuration)
    if !is_string(configuration.appRoot) or configuration.appRoot == ""
        throw "ApiAppRootMustBeConfigured"
    if !is_string(configuration.host) or configuration.host == ""
        throw "ApiHostMustBeConfigured"
    configuration.port = parsePort(configuration.port)
    validateWorkers(configuration)
    return configuration

test "configuration reads XML properties"
    configuration = defaultConfiguration("shop")
    applyXmlConfiguration(configuration, "<conf><http host=\"0.0.0.0\" port=\"3010\" /><paths appRoot=\"/app\" dataDir=\"/data\" stateDir=\"/state\" logDir=\"/log\" /></conf>")
    assert configuration.host == "0.0.0.0"
    assert configuration.port == 3010
    assert configuration.dataDir == "/data"

test "configuration applies environment then command-line values"
    configuration = defaultConfiguration("shop")
    configuration.appRoot = "/default"
    applyEnvironmentConfiguration(configuration, {
        LANGO_APP_ROOT: "/environment"
        LANGO_PORT: "3010"
    })
    applyOptionConfiguration(configuration, {
        appRoot: "/command-line"
        dataDir: null
        stateDir: null
        logDir: null
        apiFile: null
        host: null
        port: "3020"
    })
    assert configuration.appRoot == "/command-line"
    assert configuration.port == 3020

test "configuration rejects an invalid port"
    try
        parsePort("70000")
        assert false
    catch error
        assert error == "ApiPortMustBeAnIntegerBetween1And65535"

test "JWT settings follow XML environment and CLI precedence"
    configuration = defaultConfiguration("shop")
    applyXmlConfiguration(configuration, <conf><jwt issuer="xml" audience="browser" keysFile="keys.json" activeKeyId="current" ttlSeconds="600" sessionTtlSeconds="7200" /></conf>)
    applyEnvironmentConfiguration(configuration, {
        LANGO_JWT_ISSUER: "environment"
        LANGO_JWT_TTL: "1200"
        LANGO_JWT_SESSION_TTL: "14400"
    })
    applyOptionConfiguration(configuration, {
        jwtIssuer: "cli"
        jwtTtl: "1800"
        jwtSessionTtl: "21600"
    })
    assert configuration.jwt.issuer == "cli"
    assert configuration.jwt.audience == "browser"
    assert configuration.jwt.ttlSeconds == 1800
    assert configuration.jwt.sessionTtlSeconds == 21600
    assert configuration.jwt.enabled

test "JWT configuration rejects misspelled attributes and duplicate sections"
    configuration = defaultConfiguration("shop")
    try
        applyXmlConfiguration(configuration, "<conf><jwt keys=\"secret\" /></conf>")
        assert false
    catch error
        assert error == "ApiJwtUnknownAttribute: keys"
    try
        applyXmlConfiguration(configuration, "<conf><jwt /><jwt /></conf>")
        assert false
    catch error
        assert error == "ApiDuplicateJwtConfiguration"

test "JWT explicit disable can override lower settings"
    configuration = defaultConfiguration("shop")
    applyXmlConfiguration(configuration, "<conf><jwt issuer=\"xml\" /></conf>")
    applyEnvironmentConfiguration(configuration, {
        LANGO_JWT_ENABLED: "true"
    })
    applyOptionConfiguration(configuration, {
        jwtEnabled: "false"
    })
    assert !configuration.jwt.enabled

workerInteger(value, name)
    try
        parsed = to_js_number($(value))
    catch error
        throw "ApiWorkerInvalidInteger: ${name}"
    minimum = 1
    if name == "rateLimit"
        minimum = 0
    if parsed < minimum or parsed > 9007199254740991 or parsed % 1 != 0
        throw "ApiWorkerInvalidInteger: ${name}"
    if name == "rateLimit" and parsed > 1000000000
        throw "ApiRateLimitInvalidInteger"
    if name == "rateMaxClients" and parsed > 1000000
        throw "ApiRateLimitInvalidInteger"
    if name == "threads" and parsed > 128
        throw "ApiWorkerThreadLimit"
    if name == "rateWindowMs" or name == "bodyTimeoutMs" or name == "requestTimeoutMs" or name == "startupTimeoutMs" or name == "shutdownTimeoutMs"
        if parsed > 2147483647
            throw "ApiWorkerTimeoutLimit"
    return parsed

setWorker(configuration, name, value)
    if configuration.workers == null
        configuration.workers = {
            enabled: true
        }
    settings = configuration.workers
    parsed = value
    switch name
      case "enabled"
          if value != true and value != false and value != "true" and value != "false"
              throw "ApiWorkerEnabledMustBeBoolean"
          parsed = value == true or value == "true"
      case "threads"
      case "maxQueue"
      case "bodyLimit"
      case "bodyTimeoutMs"
      case "rateLimit"
      case "rateWindowMs"
      case "rateMaxClients"
      case "requestTimeoutMs"
      case "startupTimeoutMs"
      case "shutdownTimeoutMs"
          parsed = workerInteger(value, name)
    settings[name] = parsed
    return null

applyXmlWorkers(configuration, tag)
    allowed = ["enabled", "application", "threads", "maxQueue", "bodyLimit", "bodyTimeoutMs", "rateLimit", "rateWindowMs", "rateMaxClients", "requestTimeoutMs", "startupTimeoutMs", "shutdownTimeoutMs", "workerFile", "optionsFile"]
    if configuration.workers == null
        setWorker(configuration, "enabled", true)
    for tag.attributes() as name: value
        if !allowed.includes(name)
            throw "ApiWorkerUnknownAttribute: ${name}"
        setWorker(configuration, name, value)
    if tag.children().length > 0 or tag.innerText().trim() != ""
        throw "ApiWorkerConfigurationMustUseAttributes"
    return null

workersEnabled(configuration)
    settings = configuration.workers
    if settings == null
        return true
    if !is_object(settings)
        throw "ApiWorkersMustBeMap"
    if settings.enabled != null and !is_bool(settings.enabled)
        throw "ApiWorkerEnabledMustBeBoolean"
    if settings.enabled == false
        throw "ApiWorkersRequired"
    return true

validateWorkers(configuration)
    workersEnabled(configuration)
    if configuration.workers == null
        configuration.workers = {
        }
    settings = configuration.workers
    defaults = {
        application: null
        threads: 2
        maxQueue: 64
        bodyLimit: 1048576
        bodyTimeoutMs: 30000
        rateLimit: 0
        rateWindowMs: 60000
        rateMaxClients: 10000
        requestTimeoutMs: 30000
        startupTimeoutMs: 30000
        shutdownTimeoutMs: 30000
    }
    for defaults as name: value
        if settings[name] == null
            settings[name] = value
    for ["threads", "maxQueue", "bodyLimit", "bodyTimeoutMs", "rateLimit", "rateWindowMs", "rateMaxClients", "requestTimeoutMs", "startupTimeoutMs", "shutdownTimeoutMs"] as name
        settings[name] = workerInteger(settings[name], name)
    for ["application", "workerFile", "optionsFile"] as name
        value = settings[name]
        if value != null
            if !is_string(value) or value.trim() == ""
                throw "ApiWorkerInvalidPath: ${name}"
    if settings.options != null and !is_object(settings.options)
        throw "ApiWorkerOptionsMustBeMap"
    if settings.options != null and settings.optionsFile != null
        throw "ApiWorkerOptionsConflict"
    return configuration

test "worker settings follow XML environment and CLI precedence with defaults"
    configuration = defaultConfiguration("shop")
    assert workersEnabled(configuration)
    xml = <conf>
        <workers application="dist/xml.mjs" threads="3" maxQueue="9" bodyLimit="2048" optionsFile="worker.json" />
    </conf>
    applyXmlConfiguration(configuration, xml)
    applyEnvironmentConfiguration(configuration, {
        LANGO_WORKER_APPLICATION: "dist/environment.mjs"
        LANGO_WORKER_THREADS: "4"
        LANGO_WORKER_MAX_QUEUE: "12"
    })
    applyOptionConfiguration(configuration, {
        workerApplication: "dist/cli.mjs"
        workerThreads: "5"
        workerBodyLimit: "4096"
    })
    validateWorkers(configuration)
    assert workersEnabled(configuration)
    assert configuration.workers.application == "dist/cli.mjs"
    assert configuration.workers.threads == 5
    assert configuration.workers.maxQueue == 12
    assert configuration.workers.bodyLimit == 4096
    assert configuration.workers.optionsFile == "worker.json"
    defaults = defaultConfiguration("shop")
    applyOptionConfiguration(defaults, {
        workersEnabled: "true"
    })
    validateWorkers(defaults)
    assert defaults.workers.application == null
    assert defaults.workers.threads == 2
    assert defaults.workers.maxQueue == 64
    assert defaults.workers.bodyLimit == 1048576

test "worker execution is the default and cannot be disabled"
    configuration = defaultConfiguration("shop")
    validateWorkers(configuration)
    assert workersEnabled(configuration)
    configuration.workers.enabled = false
    rejected = false
    try
        validateWorkers(configuration)
    catch error
        assert error == "ApiWorkersRequired"
        rejected = true
    assert rejected

test "worker XML rejects unknown attributes duplicate sections and invalid limits"
    configuration = defaultConfiguration("shop")
    try
        applyXmlConfiguration(configuration, <conf><workers thread="4" /></conf>)
        assert false
    catch error
        assert error == "ApiWorkerUnknownAttribute: thread"
    try
        applyXmlConfiguration(configuration, <conf><workers /><workers /></conf>)
        assert false
    catch error
        assert error == "ApiDuplicateWorkersConfiguration"
    for ["0", "1.5", "-1", "invalid"] as value
        rejected = false
        try
            applyOptionConfiguration(configuration, {
                workerThreads: value
            })
        catch error
            rejected = true
        assert rejected
    try
        applyOptionConfiguration(configuration, {
            workerThreads: "129"
        })
        assert false
    catch error
        assert error == "ApiWorkerThreadLimit"
    try
        applyOptionConfiguration(configuration, {
            workersEnabled: "yes"
        })
        assert false
    catch error
        assert error == "ApiWorkerEnabledMustBeBoolean"

test "worker deadlines follow XML environment and CLI precedence and timer limits"
    configuration = defaultConfiguration("deadlines")
    applyXmlConfiguration(configuration, <conf><workers requestTimeoutMs="900" startupTimeoutMs="800" shutdownTimeoutMs="700" /></conf>)
    applyEnvironmentConfiguration(configuration, {
        LANGO_WORKER_TIMEOUT: "600"
        LANGO_WORKER_STARTUP_TIMEOUT: "500"
    })
    applyOptionConfiguration(configuration, {
        workerTimeout: "400"
        workerShutdownTimeout: "300"
    })
    validateWorkers(configuration)
    assert configuration.workers.requestTimeoutMs == 400
    assert configuration.workers.startupTimeoutMs == 500
    assert configuration.workers.shutdownTimeoutMs == 300
    defaults = defaultConfiguration("defaults")
    validateWorkers(defaults)
    assert defaults.workers.requestTimeoutMs == 30000
    assert defaults.workers.startupTimeoutMs == 30000
    assert defaults.workers.shutdownTimeoutMs == 30000
    for [0, -1, 1.5, 2147483648] as invalid
        rejected = false
        try
            applyOptionConfiguration(defaults, {
                workerTimeout: invalid
            })
        catch error
            rejected = true
        assert rejected

test "body upload timeout follows XML environment and CLI precedence"
    configuration = defaultConfiguration("upload")
    applyXmlConfiguration(configuration, <conf><workers bodyTimeoutMs="900" /></conf>)
    assert configuration.workers.bodyTimeoutMs == 900
    applyEnvironmentConfiguration(configuration, {
        LANGO_WORKER_BODY_TIMEOUT: "600"
    })
    assert configuration.workers.bodyTimeoutMs == 600
    applyOptionConfiguration(configuration, {
        workerBodyTimeout: "300"
    })
    validateWorkers(configuration)
    assert configuration.workers.bodyTimeoutMs == 300
    defaults = defaultConfiguration("defaults")
    validateWorkers(defaults)
    assert defaults.workers.bodyTimeoutMs == 30000
    for [0, -1, 1.5, 2147483648] as invalid
        rejected = false
        try
            applyOptionConfiguration(defaults, {
                workerBodyTimeout: invalid
            })
        catch error
            rejected = true
        assert rejected

test "rate limits follow XML environment and CLI precedence and remain opt in"
    configuration = defaultConfiguration("rates")
    applyXmlConfiguration(configuration, <conf><workers rateLimit="12" rateWindowMs="2000" rateMaxClients="20" /></conf>)
    applyEnvironmentConfiguration(configuration, {
        LANGO_WORKER_RATE_LIMIT: "8"
        LANGO_WORKER_RATE_WINDOW: "1000"
    })
    applyOptionConfiguration(configuration, {
        workerRateLimit: "4"
        workerRateMaxClients: "10"
    })
    validateWorkers(configuration)
    assert configuration.workers.rateLimit == 4
    assert configuration.workers.rateWindowMs == 1000
    assert configuration.workers.rateMaxClients == 10
    defaults = defaultConfiguration("defaults")
    validateWorkers(defaults)
    assert defaults.workers.rateLimit == 0
    for [-1, 1.5, 1000000001] as invalid
        rejected = false
        try
            applyOptionConfiguration(defaults, {
                workerRateLimit: invalid
            })
        catch error
            rejected = true
        assert rejected
