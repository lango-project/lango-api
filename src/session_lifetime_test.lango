import js global Date
import js global Math
import js global Promise
import js "node:crypto" as crypto
import js "node:buffer" as buffer
import js "jsonwebtoken" as jwt
import "./tokens"
    class TokenService

export main(args)

options(key, lifetime = 120)
    return {
        issuer: "lifetime-test"
        audience: "lifetime-test"
        activeKeyId: "current"
        keys: {
            current: key
        }
        ttlSeconds: 900
        sessionTtlSeconds: lifetime
    }

invalid(service, value, signing = false)
    failed = false
    try
        if signing
            service.sign(value)
          else
              service.verify(value)
    catch error
        assert error == "ApiInvalidToken"
        failed = true
    assert failed
    return null

raw(key, claims)
    claims.iss = "lifetime-test"
    claims.aud = "lifetime-test"
    claims.iat = Math/floor(Date/now() / 1000)
    claims.exp = claims.iat + 900
    claims.jti = crypto/randomUUID()
    return jwt/default/sign(claims, buffer/Buffer/from(key), {
        algorithm: "HS256"
        header: {
            kid: "current"
            typ: "lango+jwt"
        }
    })

main(args)
    key = crypto/randomBytes(32)
    for [0, -1, 1.5, 2592001, "120"] as lifetime
        rejected = false
        try
            invalidService = new TokenService(options(key, lifetime))
        catch error
            assert error == "ApiTokenSessionLifetimeMustBeBetween1And2592000Seconds"
            rejected = true
        assert rejected
    service = new TokenService(options(key))
    signed = service.sign({
        clientId: "stable-client"
        auth: true
    })
    claims = service.verify(signed)
    assert claims.sessionExpiresAt - claims.sessionStartedAt == 120
    assert claims.exp == claims.sessionExpiresAt
    renewed = service.verify(service.sign(claims))
    assert renewed.sessionStartedAt == claims.sessionStartedAt
    assert renewed.sessionExpiresAt == claims.sessionExpiresAt
    original = Date.now
    frozen = ()
        capture claims
        return claims.sessionExpiresAt * 1000
    Date.now = frozen
    try
        invalid(service, signed)
        invalid(service, claims, true)
    finally
        Date.now = original
    now = Math/floor(Date/now() / 1000)
    for ["missing", "expired", "policy", "future", "type", "partial", "client", "session"] as mode
        bad = {
            clientId: "stable-client"
            sessionId: "old-session"
            auth: true
            sessionStartedAt: now - 200
            sessionExpiresAt: now + 900
        }
        switch mode
          case "missing"
              bad.sessionStartedAt = null
              bad.sessionExpiresAt = null
          case "expired"
              bad.sessionExpiresAt = now - 1
          case "future"
              bad.sessionStartedAt = now + 60
          case "type"
              bad.sessionStartedAt = "invalid"
          case "partial"
              bad.sessionExpiresAt = null
          case "client"
              bad.clientId = 9
          case "session"
              bad.sessionId = ""
        invalid(service, raw(key, bad))
    previous = {
        clientId: "stable-client"
        sessionId: "old-session"
        auth: true
        sessionStartedAt: now - 100
        sessionExpiresAt: now + 100
    }
    tightened = new TokenService(options(key, 60))
    old = raw(key, previous)
    invalid(tightened, old)
    fresh = tightened.restart(old)
    assert fresh.clientId == "stable-client"
    assert !fresh.auth
    assert fresh.sessionExpiresAt - fresh.sessionStartedAt == 60
    longer = new TokenService(options(key, 3600))
    verified = longer.verify(old)
    assert verified.sessionExpiresAt == previous.sessionExpiresAt
    settings = options(key)
    settings.revocations = new ExpiringStore(now + 60)
    expiring = new TokenService(settings)
    try
        invalid(expiring, {
            clientId: "client"
            sessionId: "session"
            sessionStartedAt: now
            sessionExpiresAt: now + 60
        }, true)
    finally
        Date.now = original
    println("PASS renewal preserves absolute deadlines, rejects malformed/expired claims, applies policy changes and rechecks expiry after store access")

class ExpiringStore
    methods
        isRevoked(sessionId)
        revoke(sessionId, expiresAt)

ExpiringStore(deadline)
    @deadline = deadline

ExpiringStore:isRevoked(sessionId)
    deadline = @deadline
    frozen = ()
        capture deadline
        return deadline * 1000
    Date.now = frozen
    return false

ExpiringStore:revoke(sessionId, expiresAt)
    return null
