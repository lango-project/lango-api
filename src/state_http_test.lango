import js global Promise
import js global fetch
import js global AbortSignal
import js "node:fs" as fs
import js "node:path" as path
import js "node:os" as os
import js "node:crypto" as crypto
import "./library"
    class Host
    class Routes

export main(args)

class Harness
    properties
        token
        configuration
    methods
        start()
        opened(server)
        listening(completion)
        request(endpoint, input = null)
        stop()

Harness(directory)
    @directory = directory
    @server = null
    @token = null
    key = crypto/randomBytes(32)
    fs.writeFileSync(path.join(directory, "keys.json"), to_json({
        current: key.toString("base64")
    }))

Harness:start()
    @configuration = {
        applicationName: "state-http"
        host: "127.0.0.1"
        port: 0
        appRoot: @directory
        stateDir: @directory
        state: {
            backend: "sqlite"
            file: "runtime.sqlite"
        }
        jwt: {
            issuer: "state-http"
            audience: "state-http"
            keysFile: path.join(@directory, "keys.json")
            activeKeyId: "current"
        }
    }
    routes = new Routes()
    routes.endpoint({
        path: "/probe"
        function: probe
        anonymous: true
        auth: stateAuth
    })
    host = new Host(@configuration)
    host.routes(routes)
    return host.start().then((server)
        return opened(server)
    )

Harness:opened(server)
    @server = server
    pending = new Promise((resolve, reject)
        capture server
        listen(server, @this, resolve, reject)
    )
    return pending

listen(server, harness, resolve, reject)
    completion = {
        resolve: resolve
        reject: reject
    }
    if server.listening
        harness.listening(completion)
        return null
    server.once("listening", ()
        capture harness
        capture completion
        harness.listening(completion)
    )
    server.once("error", (error)
        capture completion
        completion.reject(error)
    )

Harness:listening(completion)
    address = @server.address()
    @url = "http://127.0.0.1:${address.port}"
    completion.resolve(@this)

Harness:request(endpoint, input = null)
    url = @url
    headers = {
        "Content-Type": "application/json"
    }
    if @token != null
        token = @token
        headers.Authorization = "Bearer ${token}"
    return fetch("${url}${endpoint}", {
        method: "POST"
        headers: headers
        body: to_json(input)
        signal: AbortSignal/timeout(5000)
    })

Harness:stop()
    server = @server
    @server = null
    if server == null or !server.listening
        return Promise/resolve()
    pending = new Promise((resolve, reject)
        capture server
        closeServer(server, resolve, reject)
    )
    return pending

closeServer(server, resolve, reject)
    completion = {
        resolve: resolve
        reject: reject
    }
    server.once("close", ()
        capture completion
        completion.resolve(null)
    )
    server.close()
    server.closeAllConnections()

stateAuth(path, input)
    context state
    assert state != null
    return true

probe(input)
    context state
    context token
    assert state != null
    key = to_json([token.sessionId, "profile", "instance"])
    outcome = state.claim(key, input.seqno, token.sessionExpiresAt)
    if outcome == "Accepted"
        state.complete(key, input.seqno)
    return {
        outcome: outcome
    }

main(args)
    directory = fs.mkdtempSync(path.join(os.tmpdir(), "lango-state-http-"))
    harness = new Harness(directory)
    return harness.start().then(()
        capture harness
        return harness.request("/_lango/start")
    ).then((response)
        capture harness
        assert response.status == 200
        saveToken(harness, response.headers.get("X-Lango-Token"))
        return harness.request("/probe", {
            seqno: 1
        })
    ).then((response)
        assert response.status == 200
        return response.json()
    ).then((body)
        capture harness
        assert body.outcome == "Accepted"
        return harness.stop()
    ).then(()
        capture harness
        assert harness.configuration.stateStore.isClosed()
        return afterRestart(harness)
    ).finally(()
        capture harness
        return harness.stop()
    ).finally(()
        capture directory
        cleanup(directory)
    )

saveToken(harness, token)
    harness.token = token

afterRestart(harness)
    return harness.start().then(()
        capture harness
        return harness.request("/probe", {
            seqno: 1
        })
    ).then((response)
        assert response.status == 200
        return response.json()
    ).then((body)
        capture harness
        assert body.outcome == "AlreadyConsumed"
        return harness.request("/_lango/logout")
    ).then((response)
        capture harness
        assert response.status == 200
        return harness.stop()
    ).then(()
        capture harness
        return harness.start()
    ).then(()
        capture harness
        return harness.request("/probe", {
            seqno: 2
        })
    ).then((response)
        assert response.status == 401
        assert response.headers.get("X-Lango-Token") == null
        println("PASS configured Host shares durable state with auth/handlers, closes owned stores and preserves replay/logout across HTTP restarts")
    )

cleanup(directory)
    fs.rmSync(directory, {
        recursive: true
        force: true
    })
