import js global Promise
import js global fetch
import js global AbortSignal
import js "node:crypto" as crypto
import js "jose" as jose
import "./library"
    class Host
    class Routes
import "./tokens"
    class TokenService

export main(args)

class Hooks
    properties
        forms
        audits
    methods
        ping(input)
        audit(input)

Hooks()
    @forms = []
    @audits = 0

Hooks:ping(input)
    context token
    context request
    context response
    assert request.path == "/_lango/ping"
    assert !response.completed()
    assert input.clientId == token.clientId
    assert input.sessionId == token.sessionId
    @forms.add(input.formId)
    switch input.formId
      case "fail"
          return Promise/reject("ExpectedPingFailure")
      case "send"
          return response.send("must-not-send")
    token.clientId = "must-not-change-client"
    token.sessionId = "must-not-change-session"
    token.formId = "must-not-change-form"
    token.seqno = 999
    token.sessionStartedAt = 0
    token.sessionExpiresAt = 0
    count = token.pingCount
    if count == null
        count = 0
    token.pingCount = count + 1
    return Promise/resolve()

Hooks:audit(input)
    @audits++
    return null

class Harness
    properties
        service
        key
        hooks
    methods
        begin()
        listening(completion)
        request(input)
        raw(body)
        stop()

Harness:begin()
    @key = crypto/randomBytes(32)
    @service = new TokenService({
        issuer: "ping-test"
        audience: "ping-test"
        activeKeyId: "test"
        keys: {
            test: @key
        }
    })
    @hooks = new Hooks()
    host = new Host({
        host: "127.0.0.1"
        port: 0
        appRoot: "."
        tokenService: @service
    })
    host.routes(new Routes())
    host.on({
        event: "ping"
        module: @hooks
        function: "ping"
    })
    host.on({
        event: "request"
        module: @hooks
        function: "audit"
    })
    harness = this
    return host.start().then((server)
        capture harness
        return waiting(harness, server)
    )

waiting(harness, server)
    harness.server = server
    pending = new Promise((resolve, reject)
        capture harness
        capture server
        listen(harness, server, resolve, reject)
    )
    return pending

listen(harness, server, resolve, reject)
    completion = {
        resolve: resolve
        reject: reject
    }
    server.once("listening", ()
        capture harness
        capture completion
        harness.listening(completion)
    )
    server.once("error", (error)
        capture completion
        completion.reject(error)
    )

Harness:listening(completion)
    address = this.server.address()
    @url = "http://127.0.0.1:${address.port}/_lango/ping"
    completion.resolve(this)

Harness:request(input)
    return this.raw(to_json(input))

Harness:raw(body)
    return fetch(@url, {
        method: "POST"
        headers: {
            "Content-Type": "application/json"
        }
        body: body
        signal: AbortSignal/timeout(5000)
    })

Harness:stop()
    if this.server != null
        this.server.close()
        this.server.closeAllConnections()

main(args)
    harness = new Harness()
    return harness.begin().then((ready)
        capture harness
        return tokens(harness)
    ).then((issued)
        capture harness
        return checkBatch(harness, issued)
    ).finally(()
        capture harness
        harness.stop()
    )

tokens(harness)
    left = harness.service.sign({
        clientId: "client"
        sessionId: "session"
        formId: "left"
        seqno: 7
        auth: true
    })
    right = harness.service.sign({
        clientId: "client"
        sessionId: "session"
        formId: "right"
        seqno: 3
        auth: false
    })
    general = harness.service.sign({
        clientId: "client"
        sessionId: "session"
        auth: false
    })
    signer = new jose/SignJWT({
        clientId: "client"
        sessionId: "session"
        auth: false
    })
    signer.setProtectedHeader({
        alg: "HS256"
        typ: "lango+jwt"
        kid: "test"
    })
    signer.setIssuer("ping-test")
    signer.setAudience("ping-test")
    signer.setIssuedAt(1)
    signer.setExpirationTime(2)
    signer.setJti("expired")
    expired = signer.sign(harness.key)
    return Promise/all([left, right, general, expired])

checkBatch(harness, issued)
    input = {
        forms: [{
            formId: "left"
            token: issued[0]
        }, {
            formId: "right"
            token: issued[1]
        }]
    }
    return harness.request(input).then((response)
        capture harness
        capture issued
        assert response.status == 200
        assertHeaders(response)
        return readBatch(harness, issued, response)
    )

assertHeaders(response)
    assert response.headers.get("Cache-Control") == "no-store"
    assert response.headers.get("X-Lango-Token") == null
    return null

readBatch(harness, issued, response)
    return response.json().then((body)
        capture harness
        capture issued
        return verifyBatch(harness, issued, body)
    )

verifyBatch(harness, issued, body)
    forms = body.forms
    assert forms.length == 2
    assert forms[0].formId == "left"
    assert forms[1].formId == "right"
    assert forms[0].token != issued[0]
    checks = [harness.service.verify(forms[0].token), harness.service.verify(forms[1].token)]
    return Promise/all(checks).then((claims)
        capture harness
        capture issued
        assertClaims(claims)
        assert harness.hooks.audits == 0
        return checkFailures(harness, issued, 0)
    )

assertClaims(claims)
    for claims as token
        assert token.clientId == "client"
        assert token.sessionId == "session"
        assert token.pingCount == 1
    assert claims[0].auth
    assert !claims[1].auth
    assert claims[0].seqno == 7
    assert claims[1].seqno == 3
    assert claims[0].formId == "left"
    assert claims[1].formId == "right"
    return null

failureCases(issued)
    return [{
        forms: []
        status: 400
    }, {
        forms: [{
            formId: "left"
            token: issued[0]
        }, {
            formId: "right"
            token: "invalid"
        }]
        status: 401
    }, {
        forms: [{
            formId: "left"
            token: issued[0]
        }, {
            formId: "left"
            token: issued[0]
        }]
        status: 400
    }, {
        forms: [{
            formId: "wrong"
            token: issued[0]
        }]
        status: 401
    }, {
        forms: [{
            formId: "expired"
            token: issued[3]
        }]
        status: 401
    }, {
        forms: [{
            formId: "fail"
            token: issued[2]
        }]
        status: 500
    }, {
        forms: [{
            formId: "send"
            token: issued[2]
        }]
        status: 500
    }]

checkFailures(harness, issued, index)
    cases = failureCases(issued)
    if index == cases.length
        return checkBadJson(harness)
    expected = cases[index]
    calls = harness.hooks.forms.length
    return harness.request(expected).then((response)
        capture harness
        capture issued
        capture index
        capture expected
        capture calls
        assert response.status == expected.status
        assertHeaders(response)
        if expected.status != 500
            assert harness.hooks.forms.length == calls
        assert harness.hooks.audits == 0
        return readFailure(harness, issued, index, response)
    )

readFailure(harness, issued, index, response)
    return response.json().then((body)
        capture harness
        capture issued
        capture index
        assertNoPartialBatch(body)
        return checkFailures(harness, issued, index + 1)
    )

assertNoPartialBatch(body)
    assert body.forms == null
    assert is_string(body.requestId)
    return null

checkBadJson(harness)
    return harness.raw("broken-json").then((response)
        capture harness
        assert response.status == 400
        assert harness.hooks.audits == 0
        println("PASS ping batch: per-form claims, sequence preservation, validation, expiry and callback isolation")
    )
