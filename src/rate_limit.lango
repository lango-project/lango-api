import js global performance
import js global Math

export class RateLimiter
    methods
        admit(address, now = null)

RateLimiter(options)
    @limit = integerOption(options.rateLimit, 0, 0, 1000000000)
    @window = integerOption(options.rateWindowMs, 60000, 1, 2147483647)
    @capacity = integerOption(options.rateMaxClients, 10000, 1, 1000000)
    @entries = {
    }
    @size = 0
    @sweep = 0

integerOption(value, fallback, minimum, maximum)
    if value == null
        return fallback
    if !is_number(value) or value < minimum or value > maximum or value % 1 != 0
        throw "ApiRateLimitInvalidInteger"
    return value

RateLimiter:admit(address, now = null)
    if @limit == 0
        return 0
    time = now
    if time == null
        time = performance.now()
    if time >= @sweep
        retained = {
        }
        @size = 0
        @sweep = time + @window
        for @entries as key: entry
            if time < entry.until
                retained[key] = entry
                @size = @size + 1
                if entry.until < @sweep
                    @sweep = entry.until
        @entries = retained
    key = "ip:${address}"
    if !(key in @entries)
        if @size >= @capacity
            return retrySeconds(@sweep - time)
        @entries[key] = {
            used: 0
            until: time + @window
        }
        @size = @size + 1
    entry = @entries[key]
    if time >= entry.until
        entry.used = 0
        entry.until = time + @window
    if entry.used >= @limit
        return retrySeconds(entry.until - time)
    entry.used = entry.used + 1
    return 0

retrySeconds(milliseconds)
    seconds = milliseconds / 1000
    return Math/ceil(seconds)
