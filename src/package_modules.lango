import js "node:child_process" as childProcess
import js "node:fs" as fs
import js "node:module" as nodeModule
import js "node:path" as path
import js "node:process" as process
import "./authorization"
    createAuth(spec)

export prepareLinkedPackages(appRoot, routes)
export resolveModule(appRoot, moduleName)
export validateRouteModules(appRoot, routes)

packageDirectory(appRoot, moduleName)
    return path.join(appRoot, "node_modules", moduleName)

langoBuild(packageManifest)
    if not is_object(packageManifest.lango)
        return null
    settings = packageManifest.lango
    if not is_string(settings.source) or not is_string(settings.output)
        throw "LangoPackageManifestRequiresSourceAndOutput"
    if not is_object(packageManifest.scripts) or not is_string(packageManifest.scripts.build)
        throw "LangoLinkedPackageRequiresBuildScript"
    return settings

buildLinkedPackage(appRoot, moduleName)
    directory = packageDirectory(appRoot, moduleName)
    if not fs.existsSync(directory)
        throw "LangoPackageNotInstalled: ${moduleName}"
    if not fs.lstatSync(directory).isSymbolicLink()
        return null
    manifestFile = path.join(directory, "package.json")
    if not fs.existsSync(manifestFile)
        throw "LangoLinkedPackageManifestNotFound: ${moduleName}"
    manifest = from_json(fs.readFileSync(manifestFile, "utf8"))
    settings = langoBuild(manifest)
    if settings == null
        return null
    npm = "npm"
    if process.platform == "win32"
        npm = "npm.cmd"
    childProcess/execFileSync(npm, ["run", "build"], {
        cwd: directory,
        stdio: "inherit"
    })
    if not fs.existsSync(path.join(directory, settings.output))
        throw "LangoLinkedPackageBuildDidNotProduceOutput: ${moduleName}"
    return null

prepareLinkedPackages(appRoot, routes)
    prepared = []
    targets = validationTargets(routes)
    for targets as route
        packageName = linkedPackageName(route.mod)
        if packageName != null and not prepared.includes(packageName)
            buildLinkedPackage(appRoot, packageName)
            prepared.add(packageName)
    return null

linkedPackageName(moduleName)
    if not is_string(moduleName)
        return null
    if path.isAbsolute(moduleName) or moduleName.startsWith(".") or moduleName.startsWith("node:")
        return null
    parts = moduleName.split("/")
    if moduleName.startsWith("@") and parts.length >= 2
        return "${parts[0]}/${parts[1]}"
    return parts[0]

resolveModule(appRoot, moduleName)
    resolver = nodeModule/createRequire(path.resolve(appRoot, "package.json"))
    return resolver.resolve(moduleName)

validateRouteModules(appRoot, routes)
    return validateRouteModuleAt(appRoot, validationTargets(routes), 0)

validationTargets(routes)
    targets = []
    for routes as route
        targets.add(route)
        auth = createAuth(route.auth)
        if auth != null
            if is_string(auth.function)
                moduleName = null
                moduleValue = auth.module
                if is_string(auth.module)
                    moduleName = auth.module
                    moduleValue = null
                targets.add({ path: "${route.path} (auth)", mod: moduleName, module: moduleValue, func: auth.function })
    return targets

moduleExportsFunction(module, name)
    return is_kindof(module[name], Function)

validateRouteModuleAt(appRoot, routes, index)
    if index >= routes.length
        return import_module("node:fs")
    route = routes[index]
    if not is_string(route.mod)
        if is_string(route.func) and route.module != null
            if not moduleExportsFunction(route.module, route.func)
                throw "ApiHandlerNotExported: ${route.path} -> ${route.func}"
        return validateRouteModuleAt(appRoot, routes, index + 1)
    moduleFile = resolveModule(appRoot, route.mod)
    return import_module(moduleFile).then((module)
        capture appRoot, routes, index, route
        if not moduleExportsFunction(module, route.func)
            throw "ApiHandlerNotExported: ${route.path} -> ${route.mod}.${route.func}"
        return validateRouteModuleAt(appRoot, routes, index + 1)
    )

test "Lango package manifests require a source, output and build script"
    settings = langoBuild({
        lango: { source: "src/index.lango", output: "dist/index.mjs" },
        scripts: { build: "lango build src/index.lango --out dist/index.mjs" }
    })
    assert settings.source == "src/index.lango"
    assert settings.output == "dist/index.mjs"

test "ordinary npm package manifests do not request a Lango build"
    assert langoBuild({ name: "ordinary-package" }) == null

test "module resolution uses the application package context"
    assert resolveModule("/tmp/lango-app", "node:fs") == "node:fs"
    assert resolveModule(".", "node:fs") == "node:fs"

test "linked builds use package roots and skip file and native module references"
    assert linkedPackageName("@shop/hooks/register") == "@shop/hooks"
    assert linkedPackageName("hooks/register") == "hooks"
    assert linkedPackageName("node:fs") == null
    assert linkedPackageName(path.resolve("hooks.mjs")) == null
    assert linkedPackageName("./hooks.mjs") == null

test "startup rejects a missing auth module export"
    handler = (input)
        return input
    try
        validateRouteModules("/tmp", [{ path: "/private", handler: handler, auth: { module: {}, function: "missing" } }])
        assert false
    catch error
        assert error == "ApiHandlerNotExported: /private (auth) -> missing"
