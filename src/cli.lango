import js "node:os" as os
import js "node:process" as process
import "./application_paths"
    developmentPaths(applicationName, home, localAppData, platform)
    serverPaths(applicationName, programData, programFiles, platform)
import "./configuration"
    defaultConfiguration(applicationName)
    loadConfiguration(applicationName, configurationFile, paths)
import "./server"
    start(configuration, routes)
import "./api_registry"
    loadRoutes(apiFile)

export main(args)

main(args)
    context log
    if args.length == 0
        log.err("Usage: lango-api <app> [development|server]")
        return null

    applicationName = args[0]
    mode = args[1]
    if mode == "server"
        paths = serverPaths(applicationName, process.env.ProgramData, process.env.ProgramFiles, process.platform)
      else
          paths = developmentPaths(applicationName, os.homedir(), process.env.LOCALAPPDATA, process.platform)
    configuration = loadConfiguration(applicationName, paths.configFile, paths)
    routes = loadRoutes(configuration.appRoot + "/deploy/api.xml")
    start(configuration, routes)
    log.info("lango-api listening on ${configuration.host}:${configuration.port}")
