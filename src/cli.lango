import "./configuration"
    defaultConfiguration(applicationName)
import "./server"
    start(configuration)

export main(args)

main(args)
    if args.length == 0
        println("Usage: lango-api <app> [development|server]")
        return null

    applicationName = args[0]
    configuration = defaultConfiguration(applicationName)
    start(configuration)
    println("lango-api listening on ${configuration.host}:${configuration.port}")
