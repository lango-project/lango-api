import js global Promise
import js global TextDecoder
import js global Uint8Array
import js global Date
import js global Map
import js global Array
import js global Math
import js "node:crypto" as crypto
import js "node:util" as util
import js "jose" as jose


export class TokenService
    methods
        sign(claims)
        verify(token)
        verifySigned(token)
        restart(token)
        startSession(token)
        recoverClient(token)
        revoke(claims)
        checkSession(claims)

export class MemorySessionRevocations
    methods
        revoke(sessionId, expiresAt)
        isRevoked(sessionId)

MemorySessionRevocations()
    @sessions = new Map()

MemorySessionRevocations:revoke(sessionId, expiresAt)
    now = Date/now() / 1000
    entries = Array/from(@sessions.entries())
    for entries as entry
        if entry[1] <= now
            @sessions.delete(entry[0])
    previous = @sessions.get(sessionId)
    if previous == null or previous < expiresAt
        @sessions.set(sessionId, expiresAt)
    return null

MemorySessionRevocations:isRevoked(sessionId)
    expiresAt = @sessions.get(sessionId)
    if expiresAt == null
        return false
    if expiresAt <= Date/now() / 1000
        @sessions.delete(sessionId)
        return false
    return true

TokenService(options)
    if !is_string(options.issuer) or options.issuer == ""
        throw "ApiTokenIssuerRequired"
    if !is_string(options.audience) or options.audience == ""
        throw "ApiTokenAudienceRequired"
    if !is_object(options.keys) or !is_string(options.activeKeyId)
        throw "ApiTokenKeysRequired"
    for options.keys as id: key
        if !util/types/isUint8Array(key) or key.length < 32
            throw "ApiTokenKeyRequiresAtLeast32Bytes"
    keys = options.keys
    activeKeyId = options.activeKeyId
    if !util/types/isUint8Array(keys[activeKeyId])
        throw "ApiTokenActiveKeyNotFound"
    ttl = options.ttlSeconds
    if ttl == null
        ttl = 900
    if !is_number(ttl) or ttl < 1 or ttl > 3600 or ttl % 1 != 0
        throw "ApiTokenLifetimeMustBeBetween1And3600Seconds"
    sessionTtl = options.sessionTtlSeconds
    if sessionTtl == null
        sessionTtl = 28800
    if !is_number(sessionTtl) or sessionTtl < 1 or sessionTtl > 2592000 or sessionTtl % 1 != 0
        throw "ApiTokenSessionLifetimeMustBeBetween1And2592000Seconds"
    @issuer = options.issuer
    @audience = options.audience
    @activeKeyId = options.activeKeyId
    @ttl = ttl
    @sessionTtl = sessionTtl
    @keys = {
    }
    @revocations = options.revocations
    if @revocations == null
        @revocations = new MemorySessionRevocations()
    if !is_kindof(@revocations.revoke, Function) or !is_kindof(@revocations.isRevoked, Function)
        throw "ApiTokenRevocationsStoreRequired"
    for options.keys as id: key
        @keys[id] = new Uint8Array(key)

TokenService:sign(claims)
    if not is_object(claims)
        throw "ApiTokenClaimsMustBeMap"
    payload = {
    }
    for claims as name: value
        if name == "__proto__" or name == "constructor" or name == "prototype"
            throw "ApiTokenReservedClaimName"
        payload[name] = value
    if payload.auth == null
        payload.auth = false
    if not is_bool(payload.auth)
        throw "ApiTokenAuthMustBeBoolean"
    if payload.clientId == null
        payload.clientId = crypto/randomUUID()
    if payload.sessionId == null
        payload.sessionId = crypto/randomUUID()
    requireTokenIdentity(payload)
    if payload.sessionStartedAt == null and payload.sessionExpiresAt == null
        stampSession(payload, @sessionTtl)
    now = Math/floor(Date/now() / 1000)
    deadline = sessionDeadline(payload, @sessionTtl)
    expiresAt = now + @ttl
    if deadline < expiresAt
        expiresAt = deadline
    signer = new jose/SignJWT(payload)
    signer.setProtectedHeader({
        alg: "HS256"
        typ: "lango+jwt"
        kid: @activeKeyId
    })
    signer.setIssuer(@issuer)
    signer.setAudience(@audience)
    signer.setIssuedAt(now)
    signer.setExpirationTime(expiresAt)
    signer.setJti(crypto/randomUUID())
    key = @keys[@activeKeyId]
    return checkSession(payload).then(()
        capture signer
        capture key
        return signer.sign(key)
    ).then((token)
        capture payload
        return checkedToken(@this, payload, token)
    )

checkedToken(service, claims, token)
    return service.checkSession(claims).then(()
        capture token
        return token
    )

TokenService:checkSession(claims)
    store = @revocations
    sessionTtl = @sessionTtl
    return Promise/resolve().then(()
        capture store
        capture claims
        capture sessionTtl
        sessionDeadline(claims, sessionTtl)
        return store.isRevoked(claims.sessionId)
    ).then((revoked)
        capture claims
        capture sessionTtl
        if !is_bool(revoked) or revoked
            throw "ApiInvalidToken"
        sessionDeadline(claims, sessionTtl)
        return null
    )

TokenService:revoke(claims)
    if !is_object(claims) or !is_string(claims.sessionId) or claims.sessionId == ""
        throw "ApiTokenSessionRequired"
    store = @revocations
    sessionId = claims.sessionId
    expiresAt = Date/now() / 1000 + @ttl + 5
    return Promise/resolve().then(()
        capture store
        capture sessionId
        capture expiresAt
        return store.revoke(sessionId, expiresAt)
    )

TokenService:verify(token)
    return Promise/resolve().then(()
        capture token
        return verifySigned(token)
    ).then((verified)
        claims = verifiedPayload(verified)
        return verifiedSession(@this, claims)
    ).catch((error)
        throw "ApiInvalidToken"
    )

verifiedSession(service, claims)
    return service.checkSession(claims).then(()
        capture claims
        return claims
    )

TokenService:verifySigned(token)
    if !is_string(token) or token.length > 16384
        throw "ApiInvalidToken"
    header = jose/decodeProtectedHeader(token)
    if !is_string(header.kid) or !util/types/isUint8Array(@keys[header.kid])
        throw "ApiInvalidToken"
    return jose/jwtVerify(token, @keys[header.kid], {
        algorithms: ["HS256"]
        typ: "lango+jwt"
        issuer: @issuer
        audience: @audience
        requiredClaims: ["iat", "exp", "jti"]
        maxTokenAge: @ttl
        clockTolerance: 5
    })

verifiedPayload(verified)
    if not is_bool(verified.payload.auth)
        throw "ApiInvalidToken"
    requireTokenIdentity(verified.payload)
    return verified.payload

requireTokenIdentity(claims)
    if !is_string(claims.clientId) or claims.clientId == "" or claims.clientId.length > 128
        throw "ApiInvalidToken"
    if !is_string(claims.sessionId) or claims.sessionId == "" or claims.sessionId.length > 128
        throw "ApiInvalidToken"
    return null

TokenService:restart(token)
    return startSession(token).then((session)
        return session.claims
    )

TokenService:startSession(token)
    sessionTtl = @sessionTtl
    return Promise/resolve().then(()
        capture token
        return recoverIdentity(@this, token)
    ).catch((error)
        return newIdentity()
    ).then((identity)
        capture sessionTtl
        return {
            claims: restartedClaims(identity.clientId, sessionTtl)
            registered: identity.registered
        }
    )

TokenService:recoverClient(token)
    if !is_string(token) or token.length > 16384
        throw "ApiInvalidToken"
    header = jose/decodeProtectedHeader(token)
    if header.typ != "lango+jwt" or !is_string(header.kid) or !util/types/isUint8Array(@keys[header.kid])
        throw "ApiInvalidToken"
    issuer = @issuer
    audience = @audience
    return jose/compactVerify(token, @keys[header.kid], {
        algorithms: ["HS256"]
    }).then((verified)
        capture issuer
        capture audience
        return recoveredClientId(verified, issuer, audience)
    )

newIdentity()
    return {
        clientId: crypto/randomUUID()
        registered: true
    }

recoveredIdentity(clientId)
    return {
        clientId: clientId
        registered: false
    }

recoverIdentity(service, token)
    return service.recoverClient(token).then((clientId)
        return recoveredIdentity(clientId)
    )

restartedClaims(clientId, sessionTtl)
    claims = {
        clientId: clientId
        sessionId: crypto/randomUUID()
        auth: false
    }
    stampSession(claims, sessionTtl)
    return claims

stampSession(claims, sessionTtl)
    claims.sessionStartedAt = Math/floor(Date/now() / 1000)
    claims.sessionExpiresAt = claims.sessionStartedAt + sessionTtl
    return null

sessionDeadline(claims, sessionTtl)
    startedAt = claims.sessionStartedAt
    expiresAt = claims.sessionExpiresAt
    now = Date/now() / 1000
    if !is_number(startedAt) or startedAt < 0 or startedAt % 1 != 0 or startedAt > now + 5
        throw "ApiInvalidToken"
    if !is_number(expiresAt) or expiresAt % 1 != 0 or expiresAt <= startedAt
        throw "ApiInvalidToken"
    deadline = startedAt + sessionTtl
    if expiresAt < deadline
        deadline = expiresAt
    if now >= deadline
        throw "ApiInvalidToken"
    return deadline

recoveredClientId(verified, issuer, audience)
    decoder = new TextDecoder()
    claims = from_json(decoder.decode(verified.payload))
    if claims.iss != issuer or claims.aud != audience
        throw "ApiInvalidToken"
    if !is_string(claims.clientId) or claims.clientId == "" or claims.clientId.length > 128
        throw "ApiInvalidToken"
    return claims.clientId
