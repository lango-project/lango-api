import "./api_registry"
    addRoute(routes, endpoint)
    createEndpoint(options)
    loadRoutes(apiFile)
    anonymousValue(value)
import "./package_modules"
    prepareLinkedPackages(appRoot, routes)
    validateRouteModules(appRoot, routes)
import "./server"
    alias startServer = start(configuration, routes)
import "./authorization"
    createAuth(spec)
    resolveAuth(spec, definitions)
import "./jwt_configuration"
    configureTokenService(configuration)

export class Host
    methods
        routes(routes)
        routesFromXml(apiFile)
        start()

export class Routes
    methods
        auth(options)
        endpoint(options)
        group(options)
        values()

Host(configuration)
    @configuration = configuration
    @routes = null

Host:routes(routes)
    @routes = routes.values()
    return this

Host:routesFromXml(apiFile)
    @routes = loadRoutes(apiFile)
    return this

Host:start()
    if @routes == null
        throw "ApiRoutesNotConfigured"
    configuration = @configuration
    configureTokenService(configuration)
    routes = @routes
    prepareLinkedPackages(configuration.appRoot, routes)
    return validateRouteModules(configuration.appRoot, routes).then(()
        capture configuration, routes
        return startServer(configuration, routes)
    )

Routes()
    @items = []
    @auths = {}

Routes:auth(options)
    if not is_object(options)
        throw "ApiAuthDefinitionMustBeMap"
    name = options.name
    if !is_string(name) or name == "" or name == "__proto__" or name == "constructor" or name == "prototype"
        throw "ApiAuthRequiresValidName"
    if name in @auths
        throw "ApiDuplicateAuthName: ${name}"
    @auths[name] = createAuth(options)
    return this

Routes:endpoint(options)
    addRoute(@items, createEndpoint(options))
    return this

Routes:group(options)
    if not is_object(options)
        throw "ApiGroupMustBeMap"
    path = options.path
    mod = options.module
    if path == null
        throw "ApiGroupRequiresPath"
    if path[0] != "/"
        throw "ApiGroupPathMustStartWithSlash"
    return new RouteGroup(@items, path, mod, anonymousValue(options.anonymous), options.auth)

Routes:values()
    for @items as route
        route.auth = resolveAuth(route.auth, @auths)
    return @items

class RouteGroup
    methods
        endpoint(options)
        group(options)

RouteGroup(items, path, mod, anonymous, auth)
    @items = items
    @path = path
    @mod = mod
    @anonymous = anonymous
    @auth = auth

RouteGroup:endpoint(options)
    endpoint = createEndpoint(options)
    endpoint.path = @path + endpoint.path
    if endpoint.anonymous == null
        endpoint.anonymous = @anonymous
    if endpoint.auth == null
        endpoint.auth = @auth
    if endpoint.mod == null and endpoint.module == null
        if is_string(@mod)
            endpoint.mod = @mod
          else
              endpoint.module = @mod
    addRoute(@items, endpoint)
    return this

RouteGroup:group(options)
    if not is_object(options)
        throw "ApiGroupMustBeMap"
    path = options.path
    mod = options.module
    if path == null
        throw "ApiGroupRequiresPath"
    if path[0] != "/"
        throw "ApiGroupPathMustStartWithSlash"
    if mod == null
        mod = @mod
    anonymous = anonymousValue(options.anonymous)
    if anonymous == null
        anonymous = @anonymous
    auth = options.auth
    if auth == null
        auth = @auth
    return new RouteGroup(@items, @path + path, mod, anonymous, auth)

test "route builder groups paths and modules"
    routes = new Routes()
    math = routes.group({ path: "/math", module: "@shop/math" })
    math.endpoint({ path: "/add", function: "add" })
    admin = math.group({ path: "/admin", module: "@shop/admin" })
    admin.endpoint({ path: "/status", function: "status" })
    values = routes.values()
    assert values[0].path == "/math/add"
    assert values[0].mod == "@shop/math"
    assert values[1].path == "/math/admin/status"
    assert values[1].mod == "@shop/admin"

test "route builder resolves inherited named auth and direct overrides"
    routes = new Routes()
    guard = allowAuthForTest
    override = denyAuthForTest
    routes.auth({ name: "guard", function: guard })
    group = routes.group({ path: "/private", module: "app", auth: "guard" })
    group.endpoint({ path: "/first", function: "first" })
    group.endpoint({ path: "/second", function: "second", auth: override })
    values = routes.values()
    assert values[0].auth.function == guard
    assert values[1].auth.function == override

allowAuthForTest(path, input)
    return true

denyAuthForTest(path, input)
    return false
