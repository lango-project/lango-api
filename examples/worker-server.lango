import js "@lango-project/lango-api" as api
import js "node:path" as path
import js "node:fs" as fs
import js "node:crypto" as crypto
import js global process

export main(args)

main(args)
    directory = path.resolve("data/worker-demo")
    fs.mkdirSync(directory, {
        recursive: true
        mode: 448
    })
    keyFile = path.join(directory, "keys.json")
    if !fs.existsSync(keyFile)
        key = crypto/randomBytes(32)
        legacy = path.join(directory, "jwt.key")
        if fs.existsSync(legacy)
            key = fs.readFileSync(legacy)
        fs.writeFileSync(keyFile, to_json({
            current: key.toString("base64")
        }), {
            mode: 384
            flag: "wx"
        })
    host = new api/Host({
        applicationName: "worker-demo"
        appRoot: path.resolve(".")
        stateDir: directory
        host: "127.0.0.1"
        port: 8081
        workers: {
            application: "dist/worker-demo-app.mjs"
            threads: 2
        }
        jwt: {
            issuer: "worker-demo"
            audience: "worker-demo"
            activeKeyId: "current"
            keysFile: keyFile
        }
    })
    process.once("SIGINT", ()
        capture host
        host.close()
    )
    process.once("SIGTERM", ()
        capture host
        host.close()
    )
    println("Starting the worker demo at http://127.0.0.1:8081")
    return host.start()
