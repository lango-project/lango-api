<conf>
  <http host="127.0.0.1" port="3000" />
  <state backend="sqlite" file="runtime.sqlite" namespace="my-application" maxForms="10000" />
  <jwt
    issuer="my-application"
    audience="my-application-client"
    keysFile="jwt.keys.json"
    activeKeyId="current"
    ttlSeconds="900"
    sessionTtlSeconds="28800" />
</conf>
