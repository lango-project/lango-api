import js "node:path" as path
import "../../src/library"
    class Host

export main(args)

main(args)
    host = new Host({
        applicationName: "smoke"
        host: "127.0.0.1"
        port: 39457
        appRoot: path.resolve("test/smoke")
        stateDir: path.resolve(".test-output/smoke-state")
        workers: {
            workerFile: path.resolve("dist/worker_entry.mjs")
        }
    })
    return host.start()
